{
  "routes": [
    {
      "route": "/engine-*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/game-*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/audio-*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".pck": "application/octet-stream",
    ".sample": "application/octet-stream",
    ".js": "text/javascript"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "Vary": "Accept-Encoding"
  }
}
