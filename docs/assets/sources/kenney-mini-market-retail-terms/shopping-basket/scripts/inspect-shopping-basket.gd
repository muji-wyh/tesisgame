extends SceneTree
## Source inspection only. No term candidate is generated by this script.
const BASE := "res://build/professional-english/retail-term-art-review/shopping-basket/source-inspection"
const MODEL := "res://docs/assets/sources/kenney-mini-market-retail-theme/Models/GLB format/shopping-basket.glb"
var camera: Camera3D
var target := Vector3.ZERO
var captures: Array = []

func _initialize() -> void: _run.call_deferred()

func _bounds(node: Node3D) -> AABB:
	var result := AABB()
	var first := true
	for child: MeshInstance3D in node.find_children("*", "MeshInstance3D", true, false):
		var part: AABB = node.global_transform.affine_inverse() * child.global_transform * child.get_aabb()
		result = part if first else result.merge(part)
		first = false
	return result

func _capture(name: String, at: Vector3) -> void:
	camera.position = at
	camera.look_at(target)
	for frame in range(5): await process_frame
	await RenderingServer.frame_post_draw
	assert(root.get_texture().get_image().save_png(BASE + "/" + name + ".png") == OK)
	captures.append({"file": name + ".png", "camera": [at.x, at.y, at.z]})

func _run() -> void:
	assert(DisplayServer.get_name() != "headless")
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(BASE))
	root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
	root.content_scale_size = Vector2i.ZERO
	root.min_size = Vector2i.ZERO
	root.size = Vector2i(512, 512)
	root.msaa_3d = Viewport.MSAA_4X
	var environment := WorldEnvironment.new()
	environment.environment = Environment.new()
	environment.environment.background_mode = Environment.BG_COLOR
	environment.environment.background_color = Color("f6f3e9")
	environment.environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.environment.ambient_light_color = Color.WHITE
	environment.environment.ambient_light_energy = 0.35
	root.add_child(environment)
	var light := DirectionalLight3D.new()
	light.light_color = Color("fffaf0")
	light.light_energy = 0.65
	light.rotation_degrees = Vector3(-50, -35, 0)
	light.shadow_enabled = true
	root.add_child(light)
	var document := GLTFDocument.new()
	var state := GLTFState.new()
	assert(document.append_from_file(ProjectSettings.globalize_path(MODEL), state) == OK)
	var model := document.generate_scene(state)
	root.add_child(model)
	var bounds := _bounds(model)
	model.position = Vector3(-bounds.get_center().x, -bounds.position.y, -bounds.get_center().z)
	target = Vector3(0, bounds.size.y * 0.5, 0)
	camera = Camera3D.new()
	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
	camera.size = bounds.size.length() * 1.15
	root.add_child(camera)
	await _capture("front-three-quarter", Vector3(3, 2.4, 4))
	await _capture("other-side", Vector3(-3, 2.4, 4))
	await _capture("rear-three-quarter", Vector3(3, 2.4, -4))
	await _capture("front-low", Vector3(3, 1.2, 4))
	var file := FileAccess.open(BASE + "/report.json", FileAccess.WRITE)
	file.store_string(JSON.stringify({"scope": "Original source inspection only; no final term candidate, card QA or approval.", "model_sha256": FileAccess.get_sha256(MODEL), "bounds": [bounds.position.x, bounds.position.y, bounds.position.z, bounds.size.x, bounds.size.y, bounds.size.z], "target": [target.x, target.y, target.z], "orthographic_size": camera.size, "captures": captures}, "\t") + "\n")
	file.close()
	print("Inspected original shopping-basket source in four views; no term candidate")
	quit(0)
