extends SceneTree

const Analysis = preload("res://scripts/morphology_analysis.gd")
const Resolver = preload("res://scripts/morphology_resolver.gd")
const Growth = preload("res://scripts/growth_morphology.gd")
var checks := 0
var failures := 0
var resolver := Resolver.new()

func _initialize() -> void:
	_run.call_deferred()

func check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		printerr("FAIL: " + message)

func _run() -> void:
	var record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module03-morphology-first10-2026-10-16.json"))
	var next_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module03-morphology-next10-2026-10-16.json"))
	var case_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-case-family-review-2026-10-16.json"))
	var third_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module03-morphology-third10-2026-10-16.json"))
	var fourth_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module03-morphology-fourth10-2026-10-16.json"))
	var fifth_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module03-morphology-fifth10-2026-10-16.json"))
	var graphs: Array = []
	var display_patches: Array = case_record.patches.filter(func(p: Dictionary) -> bool: return p.kind == "exact_display_case_graph_review")
	for patch: Dictionary in record.patches + next_record.patches + display_patches + third_record.patches + fourth_record.patches + fifth_record.patches:
		var envelope: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(patch.origin))
		var entries: Array = envelope.lexemes.filter(func(e: Dictionary) -> bool: return e.id == patch.id)
		check(entries.size() == 1, "One persisted exact sense: " + patch.id)
		if entries.is_empty():
			continue
		var graph: Dictionary = entries[0].morphology
		check(graph == patch.after.morphology, "Persisted graph equals independent acceptance: " + patch.id)
		check(Analysis.compile(graph).ok, "Reviewed exact graph compiles: " + patch.id)
		var pending := graph.duplicate(true)
		pending.review.status = "pending"
		check(not Analysis.compile(pending).ok, "Changing review status cannot retain admission: " + patch.id)
		graphs.append(graph)
	check(graphs.size() == 50 and resolver.configure(graphs), "All fifty production graphs configure together")
	for graph: Dictionary in graphs:
		var leaves: Array = resolver.source_tiles(graph.id)
		var by_id := {}
		check(leaves.size() == graph.parts.size(), "No extra spelling-only tile: " + graph.text)
		for index in range(leaves.size()):
			by_id[graph.parts[index].id] = leaves[index]
			check(not leaves[index].mastery_eligible, "Uncomposed input cannot award composition mastery: " + graph.text)
		var result := _resolve_node(graph, graph.roots[0], by_id)
		check(result.get("text", "") == graph.text and result.get("complete", false), "Exact whole spelling and sense: " + graph.text)
		check(result.get("lexeme_ids", []) == [graph.lexeme_id], "Exact completed sense: " + graph.text)
		check(result.get("mastery_eligible", false) == (graph.parts.size() > 1), "Only multipart unassisted composition earns mastery: " + graph.text)
		if graph.parts.size() > 1:
			by_id.clear()
			leaves = resolver.source_tiles(graph.id)
			for index in range(leaves.size()):
				leaves[index].assisted = true
				by_id[graph.parts[index].id] = leaves[index]
			result = _resolve_node(graph, graph.roots[0], by_id)
			check(not result.get("mastery_eligible", true), "Assistance cannot grant composition mastery: " + graph.text)
	var scanner: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "barcode scanner")[0]
	var reader: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "card reader")[0]
	var scanner_parts: Array = resolver.source_tiles(scanner.id)
	var reader_parts: Array = resolver.source_tiles(reader.id)
	var mixed: Dictionary = resolver.resolve(scanner_parts[2], reader_parts[2])
	check(mixed.status == "partial" and mixed.tile.text == "scanner", "Canonical er from reader produces authored scanner doubling")
	check(resolver.resolve(reader_parts[2], scanner_parts[2]).status == "invalid", "Reversed suffix/stem order remains invalid")
	_check_ing_families(graphs)
	_check_case_families(graphs, case_record)
	_check_third_families(graphs, third_record)
	_check_fourth_families(graphs, fourth_record)
	_check_fifth_families(graphs, fifth_record)
	_check_retail04_first10()
	_check_retail04_second10()
	_check_retail04_third10()
	_check_foundation02_second_language()
	_check_foundation02_third_language()
	print("Professional Retail morphology: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)

func _resolve_node(graph: Dictionary, id: String, leaves: Dictionary) -> Dictionary:
	if leaves.has(id):
		return leaves[id]
	var nodes: Array = graph.nodes.filter(func(n: Dictionary) -> bool: return n.id == id)
	if nodes.is_empty():
		check(false, "Missing authored node " + id)
		return {}
	var node: Dictionary = nodes[0]
	var left := _resolve_node(graph, node.left, leaves)
	var right := _resolve_node(graph, node.right, leaves)
	var joined: Dictionary = resolver.resolve(left, right)
	check(joined.status in ["partial", "complete"], "Authored join resolves: " + graph.text + "/" + id)
	var tile: Dictionary = joined.get("tile", {})
	check(tile.get("text", "") == node.surface, "Authored intermediate spelling: " + node.surface)
	return tile

func _check_ing_families(graphs: Array) -> void:
	var growth_graphs: Array = []
	for target: Array in [[7, "bowling"], [9, "stuffing"]]:
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/vocabulary/morphology/age-%02d.json" % target[0]))
		var entry: Dictionary = document.entries.filter(func(e: Dictionary) -> bool: return e.text == target[1])[0]
		var decorated: Dictionary = Growth.decorate(entry)
		check(decorated.morphology_status == "reviewed", "Actual Growth entry passes its normal source and identity gates: " + target[1])
		growth_graphs.append(decorated.morphology)
	check(resolver.configure(graphs + growth_graphs), "Reviewed Growth and Professional graphs configure together")
	var activity: Dictionary = resolver.source_tiles(growth_graphs[0].id)[1]
	var result_noun: Dictionary = resolver.source_tiles(growth_graphs[1].id)[1]
	check(activity.canonical_id == "english.affix.ing.activity", "Bowling supplies the existing activity identity")
	check(result_noun.canonical_id == "english.affix.ing.result-noun", "Stuffing supplies the existing result-noun identity")
	check(activity.signature != result_noun.signature, "Equal visible suffix spelling does not collapse different nominal roles")
	for text: String in ["shopping basket", "shopping cart", "fitting room", "loading bay", "clothing rack"]:
		var graph: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == text)[0]
		var leaves: Array = resolver.source_tiles(graph.id)
		var expected: Dictionary = result_noun if text == "clothing rack" else activity
		var wrong: Dictionary = activity if text == "clothing rack" else result_noun
		check(resolver.resolve(leaves[0], wrong).status == "invalid", "Different nominal suffix cannot substitute: " + text)
		var partial: Dictionary = resolver.resolve(leaves[0], expected)
		check(partial.status == "partial", "Actual Growth suffix forms a legal Professional partial: " + text)
		check(partial.get("tile", {}).get("text", "") == graph.nodes[0].surface, "Cross-source join preserves authored spelling: " + text)
		check(not partial.get("tile", {}).get("mastery_eligible", true), "Cross-source partial grants no mastery: " + text)
		var complete: Dictionary = resolver.resolve(partial.get("tile", {}), leaves[2])
		check(complete.status == "complete" and complete.tile.text == text, "Cross-source compound completes exactly: " + text)
		check(complete.get("tile", {}).get("lexeme_ids", []) == [graph.lexeme_id], "Cross-source compound retains its exact sense: " + text)
	var foundation: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/lexemes/foundation-module02.json"))
	var missing: Dictionary = foundation.lexemes.filter(func(e: Dictionary) -> bool: return e.id == "missing.not-present.adj")[0].morphology
	check(missing.review.status == "pending" and not Analysis.compile(missing).ok, "Legacy missing remains pending and inadmissible in production")
	# This resolver inspects a pending graph only as a negative structural fixture.
	var inspection := Resolver.new()
	check(inspection.configure(graphs + growth_graphs + [missing], false), "Inspection-only resolver can examine the legacy collision")
	var legacy: Array = inspection.source_tiles(missing.id)
	check(legacy[1].canonical_id == "affix.ing.suffix", "Unrelated legacy suffix identity remains unchanged")
	for text: String in ["shopping basket", "shopping cart", "fitting room", "loading bay", "clothing rack"]:
		var graph: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == text)[0]
		var leaves: Array = inspection.source_tiles(graph.id)
		check(inspection.resolve(leaves[0], legacy[1]).status == "invalid", "Legacy participial suffix cannot enter a nominal compound: " + text)
		check(inspection.resolve(legacy[0], leaves[1]).status == "invalid", "Nominal suffix cannot enter legacy missing: " + text)

func _check_case_families(graphs: Array, record: Dictionary) -> void:
	var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/vocabulary/morphology/age-07.json"))
	var entry: Dictionary = document.entries.filter(func(e: Dictionary) -> bool: return e.text == "bookcase")[0]
	var growth: Dictionary = Growth.decorate(entry)
	check(growth.morphology_status == "reviewed", "Actual Growth bookcase retains its reviewed source gate")
	var display: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "display case")[0]
	var admitted := Resolver.new()
	check(admitted.configure([display, growth.morphology]), "Reviewed display case and Growth bookcase configure without a bypass")
	var display_tiles: Array = admitted.source_tiles(display.id)
	var growth_tiles: Array = admitted.source_tiles(growth.morphology.id)
	var shared: Dictionary = admitted.resolve(display_tiles[0], growth_tiles[1])
	check(shared.status == "complete" and shared.tile.text == "display case", "Actual Growth container tile completes exact display case")
	check(shared.get("tile", {}).get("lexeme_ids", []) == [display.lexeme_id], "Shared container part does not merge complete lexical sense identities")
	var pending_graphs: Array = []
	for classification: Dictionary in record.proposal.classifications:
		var file: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(classification.resource))
		var current: Dictionary = file.lexemes.filter(func(e: Dictionary) -> bool: return e.id == classification.id)[0]
		check(current.morphology.review.status == "pending" and not Analysis.compile(current.morphology).ok, "Case-family classification does not approve a pending graph: " + classification.id)
		pending_graphs.append(current.morphology)
	# Pending graphs are included here only to inspect forbidden homonym substitution.
	var inspection := Resolver.new()
	check(inspection.configure([display, growth.morphology] + pending_graphs, false), "Inspection-only case families configure for negative checks")
	var display_source: Dictionary = inspection.source_tiles(display.id)[0]
	for classification: Dictionary in record.proposal.classifications:
		var graph: Dictionary = pending_graphs.filter(func(g: Dictionary) -> bool: return g.lexeme_id == classification.id)[0]
		var candidate: Dictionary = inspection.source_tiles(graph.id)[classification.part_index]
		var combined: Dictionary = inspection.resolve(display_source, candidate)
		if classification.family == "container":
			check(combined.status == "complete" and combined.tile.text == "display case", "Corrected container identity shares only an installed authored join: " + classification.id)
		else:
			check(combined.status == "invalid", "Event or matter case cannot replace a container: " + classification.id)

func _check_third_families(graphs: Array, record: Dictionary) -> void:
	var growth_graphs: Array = []
	for target: Array in [[7, "bowling"], [9, "stuffing"], [10, "curiosity"], [11, "responsibility"], [12, "scales"], [12, "refrigerate"]]:
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/vocabulary/morphology/age-%02d.json" % target[0]))
		var entry: Dictionary = document.entries.filter(func(e: Dictionary) -> bool: return e.id == target[1])[0]
		var decorated: Dictionary = Growth.decorate(entry)
		check(decorated.morphology_status == "reviewed", "Normal Growth admission for third-ten substitution: " + target[1])
		growth_graphs.append(decorated.morphology)
	var admitted := Resolver.new()
	check(admitted.configure(graphs + growth_graphs), "Forty reviewed graphs and actual Growth sources configure normally")
	var weighing: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "weighing scale")[0]
	var weighing_tiles: Array = admitted.source_tiles(weighing.id)
	var activity: Dictionary = admitted.source_tiles(growth_graphs[0].id)[1]
	var result_noun: Dictionary = admitted.source_tiles(growth_graphs[1].id)[1]
	var scale: Dictionary = admitted.source_tiles(growth_graphs[4].id)[0]
	var partial: Dictionary = admitted.resolve(weighing_tiles[0], activity)
	check(partial.status == "partial" and partial.tile.text == "weighing", "Reviewed Growth activity suffix forms weighing")
	check(not partial.get("tile", {}).get("mastery_eligible", true), "Weighing partial cannot grant mastery")
	check(admitted.resolve(weighing_tiles[0], result_noun).status == "invalid", "Result-noun ing cannot replace weighing activity")
	var whole: Dictionary = admitted.resolve(partial.get("tile", {}), scale)
	check(whole.status == "complete" and whole.tile.text == "weighing scale", "Reviewed Growth scale completes the selected device")
	check(whole.get("tile", {}).get("lexeme_ids", []) == [weighing.lexeme_id], "Shared scale preserves the Professional completed sense")
	var refrigerator: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "refrigerator")[0]
	var conveyor: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "conveyor belt")[0]
	whole = admitted.resolve(admitted.source_tiles(growth_graphs[5].id)[0], admitted.source_tiles(conveyor.id)[1])
	check(whole.status == "complete" and whole.tile.text == "refrigerator", "Actual atomic Growth base and reviewed Professional or form refrigerator")
	check(whole.get("tile", {}).get("lexeme_ids", []) == [refrigerator.lexeme_id], "Refrigerator completion keeps the appliance sense")
	var security_camera: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "security camera")[0]
	var security_tag: Dictionary = graphs.filter(func(g: Dictionary) -> bool: return g.text == "security tag")[0]
	var camera_tiles: Array = admitted.source_tiles(security_camera.id)
	var tag_tiles: Array = admitted.source_tiles(security_tag.id)
	for suffix_graph: Dictionary in [growth_graphs[2], growth_graphs[3]]:
		partial = admitted.resolve(camera_tiles[0], admitted.source_tiles(suffix_graph.id)[1])
		check(partial.status == "partial" and partial.tile.text == "security", "Actual Growth quality suffix preserves authored secure/security spelling")
		whole = admitted.resolve(partial.get("tile", {}), tag_tiles[2])
		check(whole.status == "complete" and whole.tile.text == "security tag", "Shared security partial completes the exact tag sense")
		check(whole.get("tile", {}).get("lexeme_ids", []) == [security_tag.lexeme_id], "Cross-security pieces preserve completed sense identity")
	var pending_graphs: Array = [record.original_held_candidate.before_morphology]
	for snapshot: Dictionary in record.scale_family_preimages:
		if snapshot.lexeme_id == weighing.lexeme_id:
			continue
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(snapshot.resource))
		var entry: Dictionary = document.lexemes.filter(func(e: Dictionary) -> bool: return e.id == snapshot.lexeme_id)[0]
		check(entry.morphology.review.status == "pending" and not Analysis.compile(entry.morphology).ok, "Other scale meaning remains pending: " + snapshot.lexeme_id)
		pending_graphs.append(entry.morphology)
	# The pending bypass is confined to negative substitution checks.
	var inspection := Resolver.new()
	check(inspection.configure(graphs + growth_graphs + pending_graphs, false), "Inspection can compare exact legacy scale parts without approving them")
	var target_tiles: Array = inspection.source_tiles(weighing.id)
	partial = inspection.resolve(target_tiles[0], target_tiles[1])
	for legacy: Dictionary in pending_graphs:
		var legacy_tiles: Array = inspection.source_tiles(legacy.id)
		for i in range(legacy.parts.size()):
			if legacy.parts[i].canonical_id == "morph.scale":
				var before: Dictionary = legacy_tiles[i].duplicate(true)
				check(inspection.resolve(partial.get("tile", {}), legacy_tiles[i]).status == "invalid", "Mixed legacy scale cannot enter corrected weighing target: " + legacy.lexeme_id)
				check(legacy_tiles[i] == before, "Rejected substitution preserves the original scale tile")

func _fourth_source(selected: RefCounted, graph: Dictionary, canonical: String) -> Dictionary:
	var matches: Array = selected.source_tiles(graph.id).filter(func(tile: Dictionary) -> bool: return tile.canonical == canonical)
	check(matches.size() == 1, "Actual graph supplies one exact constituent: " + graph.text + "/" + canonical)
	return matches[0] if matches.size() == 1 else {}

func _fourth_node(selected: RefCounted, graph: Dictionary, id: String, leaves: Dictionary) -> Dictionary:
	if leaves.has(id):
		return leaves[id]
	var nodes: Array = graph.nodes.filter(func(node: Dictionary) -> bool: return node.id == id)
	if nodes.is_empty():
		check(false, "Missing fourth-family authored node: " + graph.text + "/" + id)
		return {}
	var node: Dictionary = nodes[0]
	var joined: Dictionary = selected.resolve(_fourth_node(selected, graph, node.left, leaves), _fourth_node(selected, graph, node.right, leaves))
	check(joined.status in ["partial", "complete"] and joined.get("tile", {}).get("text") == node.surface, "Fourth-family authored node preserves its spelling: " + graph.text + "/" + id)
	return joined.get("tile", {})

func _fourth_whole(selected: RefCounted, graph: Dictionary) -> Dictionary:
	var tiles: Array = selected.source_tiles(graph.id)
	var leaves: Dictionary = {}
	for index in range(tiles.size()):
		leaves[graph.parts[index].id] = tiles[index]
	return _fourth_node(selected, graph, graph.roots[0], leaves)

func _check_fourth_families(graphs: Array, record: Dictionary) -> void:
	var by_text: Dictionary = {}
	for graph: Dictionary in graphs:
		by_text[graph.text] = graph
	var words: Array = JSON.parse_string(FileAccess.get_file_as_string("res://words.json"))
	var growth: Dictionary = {}
	var growth_graphs: Array = []
	for id: String in ["enter", "stairs", "scales", "has", "sometimes", "later", "tractor", "escalator"]:
		var matches: Array = words.filter(func(word: Dictionary) -> bool: return word.id == id)
		check(matches.size() == 1, "One actual Growth vocabulary sense for fourth-ten donor: " + id)
		if matches.is_empty():
			return
		var word: Dictionary = matches[0]
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/vocabulary/morphology/age-%02d.json" % word.min_age))
		var source_entry: Dictionary = document.entries.filter(func(entry: Dictionary) -> bool: return entry.id == id)[0]
		var decorated: Dictionary = Growth.decorate(word)
		var expected: Dictionary = source_entry.analysis.duplicate(true)
		expected.review = source_entry.review.duplicate(true)
		check(decorated.morphology_status == "reviewed" and decorated.get("morphology") == expected, "Actual Growth donor passes unchanged identity and source gates: " + id)
		if not decorated.get("morphology") is Dictionary:
			return
		growth[id] = decorated.morphology
		if id != "escalator":
			growth_graphs.append(decorated.morphology)
	var admitted := Resolver.new()
	check(admitted.configure(graphs + growth_graphs), "All persisted reviews and selected actual Growth donors configure without a bypass")
	var elevator: Dictionary = by_text.elevator
	var elevate: Dictionary = admitted.source_tiles(elevator.id)[0]
	for text: String in ["conveyor belt", "refrigerator"]:
		var suffix: Dictionary = _fourth_source(admitted, by_text[text], "-or")
		check(suffix.canonical_id == "affix.or.suffix", "Reviewed donor retains the instrument-or identity: " + text)
		var complete: Dictionary = admitted.resolve(elevate, suffix)
		check(complete.status == "complete" and complete.tile.text == "elevator" and complete.tile.lexeme_ids == [elevator.lexeme_id], "Reviewed instrument-or completes the selected elevator with authored final-e omission")
		check(complete.get("tile", {}).get("mastery_eligible", false), "Unassisted elevator composition retains its mastery route")
	for suffix: Dictionary in [_fourth_source(admitted, by_text["receipt printer"], "-er"), _fourth_source(admitted, growth.later, "-er"), _fourth_source(admitted, growth.tractor, "-or")]:
		check(admitted.resolve(elevate, suffix).status == "invalid", "Agent-er, comparative-er and the retained distinct Growth-or namespace cannot replace authored instrument-or")
	var entrance: Dictionary = by_text.entrance
	var enter: Dictionary = _fourth_source(admitted, growth.enter, "enter")
	var ance: Dictionary = _fourth_source(admitted, entrance, "-ance")
	var complete: Dictionary = admitted.resolve(enter, ance)
	check(complete.status == "complete" and complete.tile.text == "entrance" and complete.tile.lexeme_ids == [entrance.lexeme_id], "Actual Growth enter and authored nominal-ance complete entrance, preserving enter-to-entr spelling")
	check(complete.get("tile", {}).get("break_offsets", []) == [] and admitted.resolve(ance, enter).status == "invalid", "Entrance has no invented word break or reversed suffix join")
	var returns_counter: Dictionary = by_text["returns counter"]
	var return_part: Dictionary = _fourth_source(admitted, returns_counter, "return")
	var counter: Dictionary = _fourth_source(admitted, by_text.counter, "counter")
	for id: String in ["stairs", "scales"]:
		var plural: Dictionary = _fourth_source(admitted, growth[id], "-s")
		check(plural.canonical_id == "english.affix.s.plural", "Actual Growth donor supplies reviewed noun-plural-s: " + id)
		var partial: Dictionary = admitted.resolve(return_part, plural)
		check(partial.status == "partial" and partial.tile.text == "returns" and not partial.tile.mastery_eligible, "Noun-plural-s creates only the authored returns partial")
		complete = admitted.resolve(partial.get("tile", {}), counter)
		check(complete.status == "complete" and complete.tile.text == "returns counter" and complete.tile.lexeme_ids == [returns_counter.lexeme_id], "Growth noun-plural-s and reviewed counter complete only the merchandise-return sense")
	for id: String in ["has", "sometimes"]:
		var wrong_s: Dictionary = _fourth_source(admitted, growth[id], "-s")
		check(wrong_s.canonical_id != "english.affix.s.plural" and admitted.resolve(return_part, wrong_s).status == "invalid", "Third-person or adverbial-s cannot substitute for noun-plural-s: " + id)
	var pickup: Dictionary = by_text["pickup counter"]
	var pickup_tiles: Array = admitted.source_tiles(pickup.id)
	var picked: Dictionary = admitted.resolve(pickup_tiles[0], pickup_tiles[1])
	check(picked.status == "partial" and picked.tile.text == "pickup" and picked.tile.break_offsets == [] and not picked.tile.mastery_eligible, "Collection pickup uses the authored closed noun and grants no partial mastery")
	complete = admitted.resolve(picked.get("tile", {}), counter)
	check(complete.status == "complete" and complete.tile.text == "pickup counter" and complete.tile.break_offsets == [7.0] and complete.tile.lexeme_ids == [pickup.lexeme_id], "Reviewed counter completes pickup with the exact JSON numeric boundary and sense")

	var legacy: Dictionary = {}
	var legacy_graphs: Array = []
	for id: String in ["customer.buyer.n", "customer-order.customer-request-for-specified-goods.n", "service-desk.contact-function-coordinating-user-support.n", "attendance.presence-record.n", "clearance.unobstructed-space.n", "acceptance-criteria.agreed-success-conditions.n", "returns-area.designated-place-for-returned-goods.n", "counterclaim.claim-brought-against-party-who-brought-original-claim.n", "counterpart.separate-copy-of-document-used-for-parties-execution.n"]:
		var snapshots: Array = record.protected_related_entries.filter(func(snapshot: Dictionary) -> bool: return snapshot.entry.id == id)
		check(snapshots.size() == 1, "Fourth-ten provenance retains the exact legacy donor: " + id)
		if snapshots.is_empty():
			return
		var snapshot: Dictionary = snapshots[0]
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(snapshot.resource))
		var entry: Dictionary = document.lexemes.filter(func(item: Dictionary) -> bool: return item.id == id)[0]
		if id == "customer.buyer.n":
			var language_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module01-language-first10-2026-10-16.json"))
			var language_patches: Array = language_record.patches.filter(func(patch: Dictionary) -> bool: return patch.id == id)
			check(language_patches.size() == 1, "Exactly one scoped Foundation customer language patch is retained")
			if language_patches.size() != 1:
				return
			var language_patch: Dictionary = language_patches[0]
			check(entry == language_patch.after, "Live customer equals the exact later Foundation language entry")
			if entry != language_patch.after:
				return
			entry = language_patch.before.duplicate(true)
		elif id == "attendance.presence-record.n":
			var language_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module01-attendance-language-2026-10-17.json"))
			var language_patches: Array = language_record.patches.filter(func(patch: Dictionary) -> bool: return patch.id == id)
			check(language_patches.size() == 1, "Exactly one scoped Foundation attendance language patch is retained")
			if language_patches.size() != 1:
				return
			var language_patch: Dictionary = language_patches[0]
			check(entry == language_patch.after, "Live attendance equals the exact later Foundation language entry")
			if entry != language_patch.after:
				return
			entry = language_patch.before.duplicate(true)
		check(entry == snapshot.entry, "Persisted legacy entry equals its protected preimage: " + id)
		check(entry.morphology.review.status == "pending" and not Analysis.compile(entry.morphology).ok, "Related legacy graph remains pending and fails normal compiler admission: " + id)
		legacy[id] = entry.morphology
		legacy_graphs.append(entry.morphology)
	var retained_sources: Array = admitted.source_tiles(entrance.id)
	check(not admitted.configure(legacy_graphs), "Default resolver still refuses all pending fourth-family legacy donors")
	check(admitted.source_tiles(entrance.id) == retained_sources, "Failed pending configuration retains the admitted reviewed catalog")
	var inspection := Resolver.new()
	check(inspection.configure(graphs + growth_graphs + legacy_graphs, false), "Explicit inspection compares retained legacy families without approving their graphs")
	for id: String in ["attendance.presence-record.n", "clearance.unobstructed-space.n"]:
		complete = inspection.resolve(_fourth_source(inspection, growth.enter, "enter"), _fourth_source(inspection, legacy[id], "-ance"))
		check(complete.status == "complete" and complete.tile.text == "entrance" and complete.tile.lexeme_ids == [entrance.lexeme_id], "Existing nominal-ance component supports the selected entrance without promoting its legacy graph")
	check(inspection.resolve(_fourth_source(inspection, growth.enter, "enter"), _fourth_source(inspection, legacy["acceptance-criteria.agreed-success-conditions.n"], "ance")).status == "invalid", "Retained unhyphenated legacy ance remains distinct")
	var legacy_returns: Dictionary = inspection.resolve(_fourth_source(inspection, returns_counter, "return"), _fourth_source(inspection, legacy["returns-area.designated-place-for-returned-goods.n"], "s"))
	var reviewed_returns: Dictionary = inspection.resolve(_fourth_source(inspection, returns_counter, "return"), _fourth_source(inspection, returns_counter, "-s"))
	check(legacy_returns.status == "partial" and legacy_returns.tile.text == "returns" and not legacy_returns.tile.mastery_eligible, "Explicit inspection preserves the authored legacy returns-area intermediate without mastery")
	check(legacy_returns.tile.candidates == [{"analysis_id": legacy["returns-area.designated-place-for-returned-goods.n"].id, "node_id": "n1"}], "Generic-s intermediate belongs only to its pending legacy analysis")
	check(legacy_returns.tile.signature != reviewed_returns.tile.signature, "Equal returns spellings preserve distinct generic-s and noun-plural-s states")
	check(inspection.resolve(legacy_returns.tile, counter).status == "invalid", "Legacy generic-s intermediate cannot complete the reviewed returns counter")
	var help_desk: Dictionary = by_text["customer service desk"]
	var help_tiles: Array = inspection.source_tiles(help_desk.id)
	var current_customer: Dictionary = _fourth_source(inspection, legacy["customer-order.customer-request-for-specified-goods.n"], "customer")
	var historical_customer: Dictionary = _fourth_whole(inspection, legacy["customer.buyer.n"])
	check(current_customer.signature == help_tiles[0].signature and current_customer.text == "customer", "Current whole buyer customer shares the authored component identity")
	check(historical_customer.text == current_customer.text and historical_customer.signature != current_customer.signature, "Historical custom-plus-er completion remains a distinct state despite equal spelling")
	check(inspection.resolve(historical_customer, help_tiles[1]).status == "invalid", "Historical derived customer cannot replace the current whole customer constituent")
	var customer_service: Dictionary = inspection.resolve(current_customer, help_tiles[1])
	check(customer_service.status == "partial" and customer_service.tile.text == "customer service" and not customer_service.tile.mastery_eligible, "Current customer supports only the authored customer-service intermediate")
	complete = inspection.resolve(customer_service.get("tile", {}), help_tiles[2])
	check(complete.status == "complete" and complete.tile.text == "customer service desk" and complete.tile.lexeme_ids == [help_desk.lexeme_id], "Whole customer substitution preserves the selected help-counter sense")
	var service_desk: Dictionary = _fourth_whole(inspection, legacy["service-desk.contact-function-coordinating-user-support.n"])
	check(inspection.resolve(help_tiles[0], service_desk).status == "invalid", "Customer plus complete service desk cannot invent an alternate authored bracket")
	for id: String in ["counterclaim.claim-brought-against-party-who-brought-original-claim.n", "counterpart.separate-copy-of-document-used-for-parties-execution.n"]:
		var opposing_counter: Dictionary = _fourth_source(inspection, legacy[id], "counter")
		var returns_partial: Dictionary = inspection.resolve(_fourth_source(inspection, returns_counter, "return"), _fourth_source(inspection, returns_counter, "-s"))
		check(inspection.resolve(returns_partial.get("tile", {}), opposing_counter).status == "invalid", "Opposing or corresponding counter-prefix cannot replace the service surface")
	for graph: Dictionary in legacy_graphs:
		check(graph.review.status == "pending" and not Analysis.compile(graph).ok, "Inspection leaves legacy admission unchanged: " + graph.lexeme_id)

	var professional_escalator: Dictionary = by_text.escalator
	var selected_professional := Resolver.new()
	check(selected_professional.configure([professional_escalator]), "Independently reviewed Professional escalator configures through normal gate")
	var professional_tile: Dictionary = selected_professional.source_tiles(professional_escalator.id)[0]
	check(professional_tile.complete and professional_tile.lexeme_ids == [professional_escalator.lexeme_id] and not professional_tile.mastery_eligible, "Selected Professional atomic escalator exposes its exact sense without composition mastery")
	var selected_growth := Resolver.new()
	check(selected_growth.configure([growth.escalator]), "Actual reviewed Growth escalator configures through normal gate")
	var growth_tile: Dictionary = selected_growth.source_tiles(growth.escalator.id)[0]
	check(growth_tile.complete and growth_tile.lexeme_ids == [growth.escalator.lexeme_id] and not growth_tile.mastery_eligible, "Selected Growth atomic escalator exposes its exact sense without composition mastery")
	check(professional_tile.signature == growth_tile.signature and professional_escalator.lexeme_id != growth.escalator.lexeme_id, "Shared atomic escalator identity preserves distinct completed lexical senses")
	var collision := Resolver.new()
	check(collision.configure([professional_escalator, growth.escalator]), "Both independently reviewed escalator senses configure in an explicit collision catalog")
	var ambiguous: Dictionary = collision.source_tiles(professional_escalator.id)[0]
	check(ambiguous.lexeme_ids.size() == 2 and professional_escalator.lexeme_id in ambiguous.lexeme_ids and growth.escalator.lexeme_id in ambiguous.lexeme_ids and not ambiguous.complete and not ambiguous.mastery_eligible, "Combined atomic escalator retains both senses as ambiguous with no complete tile or mastery")
	var plan: Dictionary = collision.completion_plan([ambiguous])
	check(plan.status == "unavailable" and plan.reason == "no_completion_path" and plan.steps.is_empty(), "Ambiguous atomic escalator supplies no completion plan or automatic cross-corpus route")

func _fifth_has_analysis(tile: Dictionary, analysis_id: String, node_id: String = "") -> bool:
	for candidate: Dictionary in tile.get("candidates", []):
		if candidate.analysis_id == analysis_id and (node_id.is_empty() or candidate.node_id == node_id):
			return true
	return false

func _check_fifth_families(graphs: Array, record: Dictionary) -> void:
	var by_text: Dictionary = {}
	for graph: Dictionary in graphs:
		by_text[graph.text] = graph
	var words: Array = JSON.parse_string(FileAccess.get_file_as_string("res://words.json"))
	var growth: Dictionary = {}
	var growth_graphs: Array = []
	for id: String in ["window", "bag", "touch", "keyboard", "mop", "bowling", "key", "safe", "sunscreen", "stuffing", "wrap"]:
		var matches: Array = words.filter(func(word: Dictionary) -> bool: return word.id == id)
		check(matches.size() == 1, "One actual current Growth word for fifth-family donor: " + id)
		if matches.size() != 1:
			return
		var word: Dictionary = matches[0]
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/vocabulary/morphology/age-%02d.json" % word.min_age))
		var entries: Array = document.entries.filter(func(entry: Dictionary) -> bool: return entry.id == id)
		check(entries.size() == 1, "One actual current Growth source analysis: " + id)
		if entries.size() != 1:
			return
		var expected: Dictionary = entries[0].analysis.duplicate(true)
		expected.review = entries[0].review.duplicate(true)
		var decorated: Dictionary = Growth.decorate(word)
		check(decorated.get("morphology_status") == "reviewed" and decorated.get("morphology") == expected, "Actual reviewed Growth donor and source review are unchanged: " + id)
		if not decorated.get("morphology") is Dictionary:
			return
		growth[id] = decorated.morphology
		if id != "mop":
			growth_graphs.append(decorated.morphology)
	var admitted := Resolver.new()
	check(admitted.configure(graphs + growth_graphs), "All fifty persisted reviews and selected actual Growth donors pass the normal gate")
	for row: Array in [["window display", "window", "window"], ["shopping bag", "bag", "bag"], ["touchscreen", "touch", "touch"], ["keypad", "keyboard", "key"], ["shopping bag", "bowling", "-ing"]]:
		var selected: Dictionary = _fourth_source(admitted, by_text[row[0]], row[2])
		var actual: Dictionary = _fourth_source(admitted, growth[row[1]], row[2])
		check(selected.signature == actual.signature, "Fifth-family component reuses the exact actual Growth signature: " + row[1])
	for row: Array in [["window display", "window", "window", "display"], ["touchscreen", "touch", "touch", "screen"], ["keypad", "keyboard", "key", "pad"]]:
		var graph: Dictionary = by_text[row[0]]
		var joined: Dictionary = admitted.resolve(_fourth_source(admitted, growth[row[1]], row[2]), _fourth_source(admitted, graph, row[3]))
		var tile: Dictionary = joined.get("tile", {})
		check(joined.status == "complete" and tile.lexeme_ids == [graph.lexeme_id] and _fifth_has_analysis(tile, graph.id, graph.roots[0]), "Actual Growth donor completes the exact selected fifth-family analysis: " + graph.text)
	var shopping: Dictionary = by_text["shopping bag"]
	var partial: Dictionary = admitted.resolve(_fourth_source(admitted, shopping, "shop"), _fourth_source(admitted, growth.bowling, "-ing"))
	check(partial.status == "partial" and partial.tile.text == "shopping" and partial.tile.break_offsets == [] and not partial.tile.mastery_eligible, "Actual activity-ing creates authored doubled-p shopping without partial mastery")
	var completed: Dictionary = admitted.resolve(partial.get("tile", {}), _fourth_source(admitted, growth.bag, "bag"))
	check(completed.status == "complete" and completed.tile.text == "shopping bag" and completed.tile.break_offsets == [9.0] and completed.tile.lexeme_ids == [shopping.lexeme_id] and _fifth_has_analysis(completed.tile, shopping.id, shopping.roots[0]), "Actual Growth activity-ing and bag complete the exact selected shopping-bag analysis")
	for row: Array in [["keypad", "key", "key", "pad", true], ["cash safe", "safe", "safe", "cash", false], ["touchscreen", "sunscreen", "screen", "touch", false], ["gift wrap", "wrap", "wrap", "gift", false], ["shopping bag", "stuffing", "-ing", "shop", false]]:
		var graph: Dictionary = by_text[row[0]]
		var wrong: Dictionary = _fourth_source(admitted, growth[row[1]], row[2])
		var selected: Dictionary = _fourth_source(admitted, graph, row[2])
		var other: Dictionary = _fourth_source(admitted, graph, row[3])
		var refused: Dictionary = admitted.resolve(wrong, other) if row[4] else admitted.resolve(other, wrong)
		check(wrong.signature != selected.signature and refused.status == "invalid" and not _fifth_has_analysis(refused.get("tile", {}), graph.id), "Retained Growth lock-key, adjective-safe, shield-screen, action-wrap or result-ing cannot reach the selected analysis: " + row[1])

	var legacy: Dictionary = {}
	var legacy_graphs: Array = []
	for text: String in ["shopping bag", "keypad", "touchscreen"]:
		var patches: Array = record.patches.filter(func(patch: Dictionary) -> bool: return patch.after.text == text)
		check(patches.size() == 1, "Fifth provenance retains the replaced exact target: " + text)
		if patches.size() != 1:
			return
		var previous: Dictionary = patches[0].before.morphology
		check(previous.review.status == "pending" and not Analysis.compile(previous).ok, "Retired target graph remains pending in its exact provenance preimage: " + text)
		legacy[text] = previous
		legacy_graphs.append(previous)
	var broad: Dictionary = {}
	for id: String in ["safe.free-from-unacceptable-danger.adj", "sunscreen.product-intended-to-reduce-ultraviolet-exposure.n", "wrap.cover-item.v"]:
		var snapshots: Array = record.protected_related_entries.filter(func(snapshot: Dictionary) -> bool: return snapshot.entry.id == id)
		check(snapshots.size() == 1, "Fifth provenance protects the related broad Professional donor: " + id)
		if snapshots.size() != 1:
			return
		var snapshot: Dictionary = snapshots[0]
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(snapshot.resource))
		var entry: Dictionary = document.lexemes.filter(func(item: Dictionary) -> bool: return item.id == id)[0]
		check(entry == snapshot.entry and entry.morphology.review.status == "pending" and not Analysis.compile(entry.morphology).ok, "Related broad Professional graph remains its exact pending preimage: " + id)
		broad[id] = entry.morphology
		legacy_graphs.append(entry.morphology)
	var retained: Array = admitted.source_tiles(shopping.id)
	check(not admitted.configure(legacy_graphs) and admitted.source_tiles(shopping.id) == retained, "Default pending rejection preserves the admitted fifth-family catalog")
	var inspection := Resolver.new()
	check(inspection.configure(graphs + growth_graphs + legacy_graphs, false), "Explicit diagnostic bypass compares retired and broad graphs without approving them")
	for text: String in ["shopping bag", "keypad", "touchscreen"]:
		var old_graph: Dictionary = legacy[text]
		var old_tile: Dictionary = _fourth_whole(inspection, old_graph)
		check(old_tile.get("complete", false) and old_tile.get("lexeme_ids") == [by_text[text].lexeme_id] and _fifth_has_analysis(old_tile, old_graph.id, old_graph.roots[0]) and not _fifth_has_analysis(old_tile, by_text[text].id), "Legacy same-lexeme completion retains only its old analysis attribution: " + text)
	var old_shopping: Dictionary = legacy["shopping bag"]
	var old_partial: Dictionary = inspection.resolve(_fourth_source(inspection, old_shopping, "shop"), _fourth_source(inspection, old_shopping, "-ing"))
	check(old_partial.status == "partial" and old_partial.tile.text == "shopping" and not old_partial.tile.mastery_eligible and not _fifth_has_analysis(old_partial.tile, shopping.id), "Legacy generic-ing shopping is partial and never acquires the selected activity analysis")
	for row: Array in [["cash safe", "safe.free-from-unacceptable-danger.adj", "cash", "safe"], ["touchscreen", "sunscreen.product-intended-to-reduce-ultraviolet-exposure.n", "touch", "screen"], ["gift wrap", "wrap.cover-item.v", "gift", "wrap"]]:
		var graph: Dictionary = by_text[row[0]]
		var result: Dictionary = inspection.resolve(_fourth_source(inspection, graph, row[2]), _fourth_source(inspection, broad[row[1]], row[3]))
		check(result.status == "complete" and result.tile.lexeme_ids == [graph.lexeme_id] and _fifth_has_analysis(result.tile, graph.id, graph.roots[0]), "Intentional broad Professional related-base compatibility preserves the selected completed sense: " + row[3])

	var professional_mop: Dictionary = by_text.mop
	var selected_professional := Resolver.new()
	check(selected_professional.configure([professional_mop]), "Selected reviewed Professional mop passes the normal gate")
	var professional_tile: Dictionary = selected_professional.source_tiles(professional_mop.id)[0]
	check(professional_tile.complete and professional_tile.lexeme_ids == [professional_mop.lexeme_id] and not professional_tile.mastery_eligible, "Selected Professional atomic mop has its exact identity without composition mastery")
	var selected_growth := Resolver.new()
	check(selected_growth.configure([growth.mop]), "Actual reviewed Growth mop passes the normal gate")
	var growth_tile: Dictionary = selected_growth.source_tiles(growth.mop.id)[0]
	check(growth_tile.complete and growth_tile.lexeme_ids == [growth.mop.lexeme_id] and not growth_tile.mastery_eligible and growth_tile.signature == professional_tile.signature, "Actual Growth atomic mop retains its own lexical identity and shares the selected tool signature")
	check(selected_professional.configure([professional_mop, growth.mop]), "Both actual reviewed mop senses configure without renaming either identity")
	var ambiguous: Dictionary = selected_professional.source_tiles(professional_mop.id)[0]
	check(ambiguous.lexeme_ids.size() == 2 and professional_mop.lexeme_id in ambiguous.lexeme_ids and growth.mop.lexeme_id in ambiguous.lexeme_ids and ambiguous.lexeme_id == "" and not ambiguous.complete and not ambiguous.mastery_eligible, "Combined mop is a source ambiguity retaining both lexical IDs with no complete identity or mastery")
	check(_fifth_has_analysis(ambiguous, professional_mop.id, professional_mop.roots[0]) and _fifth_has_analysis(ambiguous, growth.mop.id, growth.mop.roots[0]) and professional_tile.complete and professional_tile.lexeme_ids == [professional_mop.lexeme_id], "Fresh mop sources retain both analyses while pre-switch source snapshots keep their original identity")
	var plan: Dictionary = selected_professional.completion_plan([ambiguous])
	check(plan.status == "unavailable" and plan.reason == "no_completion_path" and plan.steps.is_empty(), "Atomic mop ambiguity supplies no completion plan or automatic cross-corpus route")
	var boundaries: Dictionary = {"store directory": [6.0], "window display": [7.0], "gift wrap": [5.0], "shopping bag": [9.0], "receipt roll": [8.0], "touchscreen": [], "keypad": [], "cash safe": [5.0], "mop": [], "waste bin": [6.0]}
	for text: String in boundaries:
		var graph: Dictionary = by_text[text]
		var tile: Dictionary = _fourth_whole(admitted, graph)
		check(tile.get("text") == text and tile.get("break_offsets") == boundaries[text] and _fifth_has_analysis(tile, graph.id, graph.roots[0]), "Fifth-family exact spelling, word boundaries, and selected root attribution: " + text)
	for spelling: String in ["wrapping paper", "touch screen", "trash can"]:
		check(not by_text.has(spelling), "Accepted alternate form has no newly authored exact graph: " + spelling)

func _r04_exact(tile: Dictionary, graph: Dictionary) -> bool:
	return tile.get("complete", false) and tile.get("text", "") == graph.text and tile.get("lexeme_ids", []) == [graph.lexeme_id] and _fifth_has_analysis(tile, graph.id, graph.roots[0])

func _r04_complete(graph: Dictionary, replacements: Dictionary = {}, assisted: bool = false) -> Dictionary:
	var leaves: Array = resolver.source_tiles(graph.id)
	var states: Dictionary = {}
	if leaves.size() != graph.parts.size():
		return {}
	for index: int in range(leaves.size()):
		var part: Dictionary = graph.parts[index]
		var tile: Dictionary = replacements.get(part.id, leaves[index]).duplicate(true)
		if assisted:
			tile.assisted = true
		states[part.id] = tile
	for node: Dictionary in graph.nodes:
		var result: Dictionary = resolver.resolve(states[node.left], states[node.right])
		if result.status not in ["partial", "complete"]:
			return {}
		states[node.id] = result.tile
	return states.get(graph.roots[0], {})

func _r04_part(graph: Dictionary, canonical: String) -> Dictionary:
	for tile: Dictionary in resolver.source_tiles(graph.id):
		if tile.canonical == canonical:
			return tile
	return {}

func _r04_protected_graph(record: Dictionary, id: String) -> Dictionary:
	var rows: Array = record.protected_related_entries.filter(func(row: Dictionary) -> bool: return row.entry.id == id)
	check(rows.size() == 1, "Retail04 has one protected complete record: " + id)
	if rows.size() != 1:
		return {}
	var envelope: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(rows[0].resource))
	var current: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == id)
	check(current.size() == 1, "Retail04 actual protected record exists: " + id)
	if current.size() != 1:
		return {}
	var second_language: Dictionary = _f02s_reverse(current[0])
	check(second_language.ok, "Newest Foundation02 language state must match its exact chronological boundary")
	if not second_language.ok:
		return {}
	var comparable: Dictionary = second_language.entry
	if id == "appointment.arranged-meeting.n":
		var language_record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module01-language-second10-2026-10-16.json"))
		var language_patches: Array = language_record.patches.filter(func(patch: Dictionary) -> bool: return patch.id == id)
		check(language_patches.size() == 1, "Exactly one second-ten appointment language patch is retained")
		if language_patches.size() != 1:
			return {}
		var language_patch: Dictionary = language_patches[0]
		check(comparable == language_patch.after, "Live appointment equals the exact later language record")
		if comparable != language_patch.after:
			return {}
		comparable = language_patch.before.duplicate(true)
	check(comparable == rows[0].entry, "Retail04 protected actual record remains exact after scoped language reversal: " + id)
	if comparable != rows[0].entry:
		return {}
	return current[0].morphology

func _check_retail04_first10() -> void:
	var record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module04-morphology-first10-2026-10-16.json"))
	var by_text: Dictionary = {}
	var graphs: Array = []
	for patch: Dictionary in record.patches:
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(patch.origin))
		var entries: Array = document.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == patch.id)
		check(entries.size() == 1 and entries[0] == patch.after, "Retail04 persisted full record equals exact acceptance: " + patch.id)
		if entries.size() != 1:
			continue
		var graph: Dictionary = entries[0].morphology
		check(Analysis.compile(graph).ok and resolver.configure([graph]), "Retail04 ordinary reviewed admission: " + graph.text)
		var pending: Dictionary = graph.duplicate(true)
		pending.review.status = "pending"
		check(not Analysis.compile(pending).ok, "Retail04 pending status never inherits admission: " + graph.text)
		var result: Dictionary = _r04_complete(graph)
		check(_r04_exact(result, graph), "Retail04 exact analysis, root, spelling and sense: " + graph.text)
		check(result.get("mastery_eligible", false) == (graph.parts.size() > 1), "Retail04 atomic exposure has no composition mastery: " + graph.text)
		var helped: Dictionary = _r04_complete(graph, {}, true)
		check(_r04_exact(helped, graph) and not helped.get("mastery_eligible", true), "Retail04 assisted exposure or composition has no mastery: " + graph.text)
		by_text[graph.text] = graph
		graphs.append(graph)
		if patch.before.morphology != null:
			var old: Dictionary = patch.before.morphology
			check(not resolver.configure([old]) and resolver.configure([old], false), "Retail04 old candidate still requires inspection: " + graph.text)
			var old_result: Dictionary = _r04_complete(old)
			check(_r04_exact(old_result, old) and not _fifth_has_analysis(old_result, graph.id), "Retail04 old lexical ID cannot claim new exact graph: " + graph.text)
			check(not old_result.get("mastery_eligible", true), "Retail04 old atomic graph has no mastery: " + graph.text)
			check(resolver.configure([old, graph], false), "Retail04 old and accepted exact analyses coexist for inspection: " + graph.text)
			var selected: Dictionary = resolver.source_tiles(graph.id)[0]
			var legacy: Dictionary = resolver.source_tiles(old.id)[0]
			check(_fifth_has_analysis(selected, graph.id, graph.roots[0]) and _fifth_has_analysis(legacy, old.id, old.roots[0]), "Retail04 paired source attribution remains explicit: " + graph.text)
			if graph.text == "fabric":
				check(selected.signature != legacy.signature and not _fifth_has_analysis(legacy, graph.id), "Retail04 old fabric family stays separate without migration")
	check(graphs.size() == 10 and resolver.configure(graphs), "Retail04 ten reviewed production graphs configure normally")
	var words: Array = JSON.parse_string(FileAccess.get_file_as_string("res://words.json"))
	var growth: Dictionary = {}
	for id: String in ["attachment", "environment", "material", "fabric", "sort", "ant"]:
		var actual: Array = words.filter(func(word: Dictionary) -> bool: return word.id == id)
		check(actual.size() == 1, "Retail04 actual Growth source exists: " + id)
		if actual.size() != 1:
			return
		var decorated: Dictionary = Growth.decorate(actual[0])
		check(decorated.morphology_status == "reviewed", "Retail04 actual Growth decoration admits source: " + id)
		growth[id] = decorated.morphology
	var assortment: Dictionary = by_text.assortment
	check(resolver.configure([assortment]), "Retail04 assortment isolated reviewed catalog")
	var base: Dictionary = resolver.source_tiles(assortment.id)[0]
	var ending: Dictionary = resolver.source_tiles(assortment.id)[1]
	check(resolver.resolve(ending, base).status == "invalid", "Retail04 reversed assortment order rejected")
	for part: Dictionary in [base, ending]:
		check(not part.complete and not part.mastery_eligible and resolver.completion_plan([part]).status == "unavailable", "Retail04 lone assortment component has no mastery or completion")
	for index: int in [0, 1]:
		var helped: Dictionary = (base if index == 0 else ending).duplicate(true)
		helped.assisted = true
		var result: Dictionary = _r04_complete(assortment, {assortment.parts[index].id: helped})
		check(_r04_exact(result, assortment) and not result.mastery_eligible, "Retail04 either assisted component removes mastery")
	for donor_ids: Array in [["attachment"], ["environment"], ["attachment", "environment"]]:
		var catalog: Array = [assortment]
		for id: String in donor_ids:
			catalog.append(growth[id])
		check(resolver.configure(catalog), "Retail04 real reviewed result-ment donors configure normally")
		for id: String in donor_ids:
			var donor: Dictionary = growth[id]
			var suffix: Dictionary = _r04_part(donor, "-ment")
			check(suffix.canonical_id == "english.affix.ment.result" and suffix.text == "ment", "Retail04 actual result-ment identity and surface")
			var result: Dictionary = _r04_complete(assortment, {"p2": suffix})
			check(_r04_exact(result, assortment) and result.break_offsets == [], "Retail04 donor reaches only exact assortment root")
			check(_r04_exact(_r04_complete(donor), donor), "Retail04 complete donor sense stays distinct")
	for item: Array in [["appointment.arranged-meeting.n", "-ment", "p2"], ["statement.program-instruction-unit.n", "ment", "p2"], ["sort.group-by-kind.v", "sort", "p1"]]:
		var wrong_graph: Dictionary = _r04_protected_graph(record, item[0])
		check(wrong_graph.review.status == "pending" and resolver.configure([assortment, wrong_graph], false), "Retail04 unchanged generic family is inspection only")
		var wrong: Dictionary = _r04_part(wrong_graph, item[1])
		check(not _r04_exact(_r04_complete(assortment, {item[2]: wrong}), assortment), "Retail04 spelling alone cannot donate assort or result-ment")
	check(resolver.configure([assortment, growth.sort]), "Retail04 actual Growth sort configures normally")
	check(not _r04_exact(_r04_complete(assortment, {"p1": resolver.source_tiles(growth.sort.id)[0]}), assortment), "Retail04 sort cannot substitute for assort")
	var numerical_range: Dictionary = _r04_protected_graph(record, "range.maximum-minus-minimum.n")
	for pair: Array in [[by_text.material, growth.material], [by_text.fabric, growth.fabric], [by_text.range, numerical_range]]:
		var chosen: Dictionary = pair[0]
		var other: Dictionary = pair[1]
		check(resolver.configure(pair, false), "Retail04 atomic collision catalog configures for inspection")
		var tile: Dictionary = resolver.source_tiles(chosen.id)[0]
		check(tile.lexeme_ids.size() == 2 and chosen.lexeme_id in tile.lexeme_ids and other.lexeme_id in tile.lexeme_ids, "Retail04 ambiguous source retains both complete lexical identities")
		check(not tile.complete and tile.lexeme_id == "" and not tile.mastery_eligible, "Retail04 ambiguous atomic source grants no arbitrary completion or mastery")
		check(_fifth_has_analysis(tile, chosen.id, chosen.roots[0]) and _fifth_has_analysis(tile, other.id, other.roots[0]), "Retail04 ambiguous source retains exact analysis/root attribution")
		check(resolver.completion_plan([tile]).status == "unavailable", "Retail04 atomic source ambiguity offers no automatic completion")
	var color: Dictionary = by_text.color
	check(resolver.configure([color]), "Retail04 exact color graph configures")
	var color_tile: Dictionary = resolver.source_tiles(color.id)[0]
	check(color_tile.text == "color" and _r04_exact(color_tile, color), "Retail04 color root does not silently author colour")
	var spelling_only: Dictionary = color.duplicate(true)
	spelling_only.text = "colour"
	check(not Analysis.compile(spelling_only).ok, "Retail04 language variant needs its own exact graph")

func _r04s_exact(result: Dictionary, graph: Dictionary) -> bool:
	var tile: Dictionary = result.get("tile", {})
	return result.get("status") == "complete" and tile.get("text") == graph.text and tile.get("lexeme_id") == graph.lexeme_id and tile.get("lexeme_ids") == [graph.lexeme_id] and _fifth_has_analysis(tile, graph.id, graph.roots[0])

func _r04s_source(active: Resolver, graph: Dictionary, part_id: String) -> Dictionary:
	for tile: Dictionary in active.source_tiles(graph.id):
		if tile.origins == [{"analysis_id": graph.id, "part_id": part_id}]:
			return tile
	return {}

func _r04s_complete(active: Resolver, graph: Dictionary, replacements: Dictionary = {}) -> Dictionary:
	var states: Dictionary = {}
	for part: Dictionary in graph.parts:
		states[part.id] = replacements.get(part.id, _r04s_source(active, graph, part.id)).duplicate(true)
		if states[part.id].is_empty():
			return {"status": "invalid", "reason": "missing_source", "tile": {}}
	for node: Dictionary in graph.nodes:
		var result: Dictionary = active.resolve(states[node.left], states[node.right])
		if result.status not in ["partial", "complete"]:
			return result
		states[node.id] = result.tile
	var tile: Dictionary = states[graph.roots[0]]
	return {"status": "complete" if tile.complete else "partial", "reason": "", "tile": tile}

func _r04s_refused(result: Dictionary, target: Dictionary, reason: String = "no_authored_join") -> void:
	check(result.status == "invalid" and result.reason == reason, "Retail04 second-ten rejects wrong composition: " + reason)
	check(result.get("tile", {}).is_empty() and not _fifth_has_analysis(result.get("tile", {}), target.id, target.roots[0]) and not result.get("tile", {}).get("mastery_eligible", false), "Retail04 refused composition gives no completed target or mastery")

func _check_retail04_second10() -> void:
	var record: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module04-morphology-second10-2026-10-16.json"))
	var by_text: Dictionary = {}
	var accepted: Array = []
	var atomic_count: int = 0
	var legacy_count: int = 0
	for patch: Dictionary in record.patches:
		var envelope: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(patch.origin))
		var found: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == patch.id)
		check(found.size() == 1 and found[0] == patch.after, "Retail04 second-ten persisted full record equals exact accepted output: " + patch.id)
		if found.size() != 1:
			return
		var graph: Dictionary = found[0].morphology
		by_text[graph.text] = graph
		accepted.append(graph)
		check(Analysis.compile(graph).ok and resolver.configure([graph]), "Retail04 second-ten reviewed production graph admits normally")
		var original: Array = record.author_candidates.filter(func(candidate: Dictionary) -> bool: return candidate.id == graph.id)
		check(original.size() == 1 and original[0].review.status == "pending" and not Analysis.compile(original[0]).ok, "Retail04 preserved authored candidate remains pending")
		var admitted: Array = resolver.source_tiles(graph.id)
		var pending: Dictionary = graph.duplicate(true)
		pending.review.status = "pending"
		check(not Analysis.compile(pending).ok and not resolver.configure([pending]) and resolver.source_tiles(graph.id) == admitted, "Retail04 review downgrade rejects and preserves existing admitted catalog")
		var own: Dictionary = _r04s_complete(resolver, graph)
		check(_r04s_exact(own, graph), "Retail04 second-ten exact lexical ID, spelling, analysis ID and actual root")
		check(own.tile.break_offsets == ([7.0] if graph.text == "tissue paper" else []), "Retail04 exact parsed JSON word boundary")
		check(own.tile.mastery_eligible == (graph.kind != "atomic"), "Retail04 atomic exposure never grants composition mastery")
		if graph.kind == "atomic":
			atomic_count += 1
		for part: Dictionary in graph.parts:
			var leaf: Dictionary = _r04s_source(resolver, graph, part.id)
			check(leaf.break_offsets == [] and not leaf.composed and not leaf.mastery_eligible, "Retail04 exact source has no breaks or composition mastery")
			var helped: Dictionary = leaf.duplicate(true)
			helped.assisted = true
			var assisted: Dictionary = _r04s_complete(resolver, graph, {part.id: helped})
			check(_r04s_exact(assisted, graph) and assisted.tile.assisted and not assisted.tile.mastery_eligible, "Retail04 assisting any source removes mastery")
			if graph.kind != "atomic":
				check(not leaf.complete and resolver.completion_plan([leaf]).status == "unavailable", "Retail04 one constituent is incomplete and cannot automatically finish")
		if graph.kind != "atomic":
			_r04s_refused(resolver.resolve(_r04s_source(resolver, graph, "p2"), _r04s_source(resolver, graph, "p1")), graph)
		if patch.before.morphology != null:
			legacy_count += 1
			var old: Dictionary = patch.before.morphology
			check(old.review.status == "pending" and not resolver.configure([old]) and resolver.configure([old], false), "Retail04 exact old graph is inspection only")
			var previous: Dictionary = _r04s_complete(resolver, old)
			check(_r04s_exact(previous, old) and not _fifth_has_analysis(previous.tile, graph.id, graph.roots[0]), "Retail04 old lexical ID cannot credit absent candidate root")
			check(resolver.configure([graph, old], false), "Retail04 exact old and reviewed graph coexist only with explicit old-graph inspection")
			var previous_combined: Dictionary = _r04s_complete(resolver, old)
			var current_combined: Dictionary = _r04s_complete(resolver, graph)
			check(_r04s_exact(previous_combined, old) and _r04s_exact(current_combined, graph), "Retail04 combined old/new attributions use their actual distinct roots")
			var retained: bool = graph.text in ["cotton", "leather", "metal"]
			check(_fifth_has_analysis(previous_combined.tile, graph.id, graph.roots[0]) == retained and _fifth_has_analysis(current_combined.tile, old.id, old.roots[0]) == retained, "Retail04 only retained exact canonical pairs share terminal attribution")
	check(accepted.size() == 10 and atomic_count == 8 and legacy_count == 9 and resolver.configure(accepted), "Retail04 second-ten exact ten reviewed graphs, eight exposures and nine preserved old graphs")
	var words: Array = JSON.parse_string(FileAccess.get_file_as_string("res://words.json"))
	var growth: Dictionary = {}
	for row: Dictionary in record.protected_growth_entries:
		var matches: Array = words.filter(func(word: Dictionary) -> bool: return word.id == row.entry.id)
		var frozen_words: Array = record.protected_growth_dependency_supplement.actual_growth_words.filter(func(item: Dictionary) -> bool: return item.entry_id == row.entry.id)
		var cohort: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://" + row.resource))
		var actual: Array = cohort.entries.filter(func(entry: Dictionary) -> bool: return entry.id == row.entry.id)
		check(matches.size() == 1 and frozen_words.size() == 1 and matches[0] == frozen_words[0].word and actual.size() == 1 and actual[0] == row.entry, "Retail04 actual Growth word and cohort record remain exact")
		if matches.size() != 1:
			return
		var decorated: Dictionary = Growth.decorate(matches[0])
		var expected: Dictionary = row.entry.analysis.duplicate(true)
		expected.review = row.entry.review.duplicate(true)
		check(decorated.get("morphology_status") == "reviewed" and decorated.get("morphology") == expected and Analysis.compile(expected).ok, "Retail04 actual Growth.decorate returns the unchanged reviewed graph")
		growth[row.entry.id] = decorated.morphology
	check(growth.size() == 21, "Retail04 all twenty-one actual Growth donor and contrast records inspected")
	for text: String in ["wool", "plastic", "wood"]:
		var chosen: Dictionary = by_text[text]
		var other: Dictionary = growth[text]
		check(resolver.configure([chosen, other]), "Retail04 reviewed atomic collision catalog admits normally")
		var a: Dictionary = resolver.source_tiles(chosen.id)[0]
		var b: Dictionary = resolver.source_tiles(other.id)[0]
		check(a.signature == b.signature and a.lexeme_ids.size() == 2 and chosen.lexeme_id in a.lexeme_ids and other.lexeme_id in a.lexeme_ids, "Retail04 same atomic source retains two distinct complete IDs")
		check(not a.complete and a.lexeme_id == "" and not a.mastery_eligible and _fifth_has_analysis(a, chosen.id, chosen.roots[0]) and _fifth_has_analysis(a, other.id, other.roots[0]), "Retail04 source ambiguity gives no arbitrary completion or mastery")
		var plan: Dictionary = resolver.completion_plan([a, b])
		check(plan.status == "unavailable" and plan.reason == "no_completion_path" and _r04s_complete(resolver, chosen).status == "partial", "Retail04 atomic source ambiguity is partial recognition, not a merge diagnostic")
	var material: Dictionary = by_text.glass
	var hourglass: Dictionary = growth.hourglass
	check(resolver.configure([material, hourglass, growth.glass]), "Retail04 actual material and vessel graphs admit normally")
	var material_source: Dictionary = _r04s_source(resolver, material, "whole")
	var vessel_source: Dictionary = _r04s_source(resolver, growth.glass, "whole")
	check(material_source.signature == _r04s_source(resolver, hourglass, "part2").signature and material_source.signature != vessel_source.signature, "Retail04 actual hourglass material differs from drinking vessel")
	var timer: Dictionary = resolver.resolve(_r04s_source(resolver, hourglass, "part1"), material_source)
	check(_r04s_exact(timer, hourglass) and not _fifth_has_analysis(timer.tile, material.id, material.roots[0]), "Retail04 material component completes only actual hourglass root")
	_r04s_refused(resolver.resolve(_r04s_source(resolver, hourglass, "part1"), vessel_source), hourglass)
	check(resolver.configure([by_text.wood, growth.woodpecker]), "Retail04 actual woodpecker and material admit normally")
	var pecker: Dictionary = resolver.resolve(_r04s_source(resolver, growth.woodpecker, "part2"), _r04s_source(resolver, growth.woodpecker, "part3"))
	check(pecker.status == "partial" and not pecker.tile.mastery_eligible, "Retail04 peck plus er is a partial without mastery")
	var bird: Dictionary = resolver.resolve(_r04s_source(resolver, by_text.wood, "whole"), pecker.tile)
	check(_r04s_exact(bird, growth.woodpecker) and not _fifth_has_analysis(bird.tile, by_text.wood.id, by_text.wood.roots[0]), "Retail04 compatible wood preserves complete bird identity")
	var tissue: Dictionary = by_text["tissue paper"]
	for item: Array in [["paper", "whole"], ["sandpaper", "part2"], ["newspaper", "part2"], ["paperclip", "part1"]]:
		var donor: Dictionary = growth[item[0]]
		check(resolver.configure([tissue, donor]), "Retail04 reviewed paper donor catalog admits normally")
		var source: Dictionary = _r04s_source(resolver, donor, item[1])
		var whole: Dictionary = _r04s_complete(resolver, tissue, {"p2": source})
		check(_r04s_exact(whole, tissue) and whole.tile.break_offsets == [7.0] and source.origins[0] in whole.tile.origins, "Retail04 actual paper donor completes exact phrase and preserves source origin")
		_r04s_refused(resolver.resolve(source, _r04s_source(resolver, tissue, "p1")), tissue)
		var donor_whole: Dictionary = _r04s_complete(resolver, donor)
		check(_r04s_exact(donor_whole, donor) and not _fifth_has_analysis(donor_whole.tile, tissue.id, tissue.roots[0]), "Retail04 complete donor may share a component attribution but never the tissue-paper root")
	var cardboard: Dictionary = by_text.cardboard
	for item: Array in [["card", "whole", "p1"], ["cardboard", "part1", "p1"], ["cardboard", "part2", "p2"]]:
		var donor: Dictionary = growth[item[0]]
		var donor_resolver := Resolver.new()
		check(donor_resolver.configure([donor]) and resolver.configure([cardboard]), "Retail04 separate actual donor and selected target catalogs")
		var source: Dictionary = _r04s_source(donor_resolver, donor, item[1])
		var result: Dictionary = _r04s_complete(resolver, cardboard, {item[2]: source})
		check(_r04s_exact(result, cardboard) and source.origins[0] in result.tile.origins and not _fifth_has_analysis(result.tile, donor.id, donor.roots[0]), "Retail04 selected target preserves donor origin without graph relabeling")
	check(resolver.configure([cardboard, growth.cardboard]), "Retail04 actual combined cardboard target catalog")
	var cards: Array = [_r04s_source(resolver, cardboard, "p1"), _r04s_source(resolver, growth.cardboard, "part1")]
	var boards: Array = [_r04s_source(resolver, cardboard, "p2"), _r04s_source(resolver, growth.cardboard, "part2")]
	for card: Dictionary in cards:
		for board: Dictionary in boards:
			_r04s_refused(resolver.resolve(card, board), cardboard, "ambiguous_sense")
	var ambiguous_plan: Dictionary = resolver.completion_plan([cards[0], boards[0]])
	check(resolver.compatible_pairs([cards[0], boards[0]]).is_empty() and ambiguous_plan.status == "unavailable" and ambiguous_plan.reason == "no_completion_path", "Retail04 ambiguous cardboard has no arbitrary hint or plan")
	for id: String in ["cupboard", "keyboard", "skateboard", "whiteboard", "blackboard", "clipboard", "headboard"]:
		check(resolver.configure([cardboard, growth[id]]), "Retail04 actual wrong board sense admitted for contrast")
		_r04s_refused(_r04s_complete(resolver, cardboard, {"p2": _r04s_source(resolver, growth[id], "part2")}), cardboard)
	check(resolver.configure([tissue, growth.tissue]), "Retail04 actual facial-tissue contrast admits normally")
	_r04s_refused(_r04s_complete(resolver, tissue, {"p1": _r04s_source(resolver, growth.tissue, "whole")}), tissue)
	for item: Array in [["cardboard", "debit-card.account-payment-card.n", "p2", "p1"], ["cardboard", "credit-card.credit-payment-card.n", "p2", "p1"], ["cardboard", "keyboard.computer-input.n", "p2", "p2"], ["cardboard", "half-board.accommodation-arrangement-including-two-stated-meals.n", "p2", "p2"], ["tissue paper", "tissue.body-cell-organization.n", "p1", "p1"], ["tissue paper", "facial-tissue.soft-disposable-paper-for-wiping-face-or-nose.n", "p2", "p1"], ["tissue paper", "connective-tissue.tissue-supporting-connecting-or-binding-body-structures.n", "p2", "p1"]]:
		var target: Dictionary = by_text[item[0]]
		var rows: Array = record.protected_related_entries.filter(func(row: Dictionary) -> bool: return row.entry.id == item[1])
		check(rows.size() == 1, "Retail04 exact Professional negative source is protected")
		if rows.size() != 1:
			continue
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(rows[0].resource))
		var actual: Array = document.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == item[1])
		check(actual.size() == 1 and actual[0] == rows[0].entry, "Retail04 actual Professional contrast remains exact")
		var donor: Dictionary = rows[0].entry.morphology
		check(donor.review.status == "pending" and not Analysis.compile(donor).ok and resolver.configure([target, donor], false), "Retail04 pending contrast never gains automatic review")
		_r04s_refused(_r04s_complete(resolver, target, {item[3]: _r04s_source(resolver, donor, item[2])}), target)
	check(resolver.configure([by_text.plastic, by_text.ceramic, growth.magnetic]), "Retail04 actual reviewed magnetic suffix is only a contrast")
	var suffix: Dictionary = _r04s_source(resolver, growth.magnetic, "part2")
	check(suffix.canonical_id == "english.affix.ic.relating" and suffix.canonical == "-ic", "Retail04 exact real ic suffix is inspected")
	for target: Dictionary in [by_text.plastic, by_text.ceramic]:
		check(target.kind == "atomic" and target.parts.size() == 1 and target.nodes.is_empty() and target.parts[0].surface == target.text, "Retail04 plastic and ceramic keep bounded current-noun exposure depth")
		_r04s_refused(resolver.resolve(_r04s_source(resolver, target, "whole"), suffix), target)

var _r04t_graphs: Dictionary = {}
var _r04t_selected_rows: Dictionary = {}
var _r04t_input: Dictionary = {}
var _r04t_record: Dictionary = {}

func _r04t_has_analysis(tile: Dictionary, analysis_id: String, node_id: String = "") -> bool:
	for candidate: Dictionary in tile.get("candidates", []):
		if candidate.analysis_id == analysis_id and (node_id.is_empty() or candidate.node_id == node_id):
			return true
	return false


func _r04t_as_result(tile: Dictionary) -> Dictionary:
	return {"status": "complete" if tile.get("complete", false) else "partial", "reason": "", "tile": tile}


func _r04t_is_exact(result: Dictionary, graph: Dictionary) -> bool:
	var tile: Dictionary = result.get("tile", {})
	return result.get("status") == "complete" and tile.get("text") == graph.text \
		and tile.get("lexeme_id") == graph.lexeme_id and tile.get("lexeme_ids") == [graph.lexeme_id] \
		and _r04t_has_analysis(tile, graph.id, graph.roots[0])


func _r04t_source(resolver: Resolver, graph: Dictionary, part_id: String) -> Dictionary:
	for tile: Dictionary in resolver.source_tiles(graph.id):
		if tile.origins == [{"analysis_id": graph.id, "part_id": part_id}]:
			return tile
	return {}


func _r04t_complete(resolver: Resolver, graph: Dictionary, replacements: Dictionary = {}) -> Dictionary:
	var states: Dictionary = {}
	for part: Dictionary in graph.parts:
		var tile: Dictionary = replacements.get(part.id, _r04t_source(resolver, graph, part.id)).duplicate(true)
		if tile.is_empty():
			return {"status": "invalid", "reason": "missing_source_tile", "tile": {}}
		states[part.id] = tile
	for node: Dictionary in graph.nodes:
		var result: Dictionary = resolver.resolve(states[node.left], states[node.right])
		if result.status not in ["partial", "complete"]:
			return result
		states[node.id] = result.tile
	return _r04t_as_result(states[graph.roots[0]])


func _r04t_resolver(catalog: Array, require_reviewed: bool = true) -> Resolver:
	var resolver := Resolver.new()
	check(resolver.configure(catalog, require_reviewed), "Exact catalog configures with declared review gate.")
	return resolver


func _r04t_invalid_join(result: Dictionary, target: Dictionary, reason: String = "no_authored_join") -> void:
	check(result.get("status") == "invalid" and result.get("reason") == reason, "Expected refusal: " + reason)
	check(result.get("tile", {}).is_empty() and not _r04t_has_analysis(result.get("tile", {}), target.id, target.roots[0]), "Refused join has no completed target attribution.")
	check(not result.get("tile", {}).get("mastery_eligible", false), "Refused join has no mastery.")


func _r04t_atomic_collision(graph: Dictionary, other: Dictionary) -> Dictionary:
	var isolated: Dictionary = _r04t_complete(_r04t_resolver([graph]), graph)
	var donor: Dictionary = _r04t_complete(_r04t_resolver([other], true), other)
	check(_r04t_is_exact(isolated, graph) and _r04t_is_exact(donor, other), "Isolated atomic identities are exact.")
	check(graph.lexeme_id != other.lexeme_id and isolated.tile.signature == donor.tile.signature, "Same atomic signature retains distinct complete lexical IDs.")
	var resolver: Resolver = _r04t_resolver([graph, other], other.review.status == "reviewed")
	var sources: Array = [_r04t_source(resolver, graph, graph.roots[0]), _r04t_source(resolver, other, other.roots[0])]
	for tile: Dictionary in sources:
		check(tile.lexeme_ids.size() == 2 and graph.lexeme_id in tile.lexeme_ids and other.lexeme_id in tile.lexeme_ids, "Combined atomic source records both lexical IDs.")
		check(not tile.complete and tile.lexeme_id == "" and not tile.composed and not tile.mastery_eligible, "Combined atomic recognition has no arbitrary completion or mastery.")
		check(_r04t_has_analysis(tile, graph.id, graph.roots[0]) and _r04t_has_analysis(tile, other.id, other.roots[0]), "Combined atomic source preserves both actual root attributions.")
	var plan: Dictionary = resolver.completion_plan(sources)
	check(plan.status == "unavailable" and plan.reason == "no_completion_path" and plan.steps.is_empty(), "Atomic collision has no completion plan.")
	check(resolver.compatible_pairs(sources).is_empty() and _r04t_complete(resolver, graph).status == "partial", "Atomic ambiguity is partial recognition, with no merge or hint pair.")
	return {"isolated_selected": isolated, "isolated_growth": donor, "combined_sources": sources, "plan": plan}


func _r04t_relation(test: Dictionary, graph: Dictionary) -> Dictionary:
	var relation: Dictionary = test.source
	var descriptor: Dictionary = relation.source
	var other: Dictionary = _r04t_graphs[descriptor.analysis_id]
	var before: Dictionary = other.duplicate(true)
	check(graph.id == relation.target_analysis_id and graph.roots == [relation.target_root] and other.roots == [descriptor.root], "Relation uses exact selected and actual source roots.")
	var donor_resolver: Resolver = _r04t_resolver([other], other.review.status == "reviewed")
	if other.review.status == "pending":
		var ordinary := Resolver.new()
		check(not Analysis.compile(other).ok and not ordinary.configure([other]), "Actual pending Professional donor requires explicit inspection.")
	var target_resolver: Resolver = _r04t_resolver([graph])
	var donor: Dictionary = _r04t_source(donor_resolver, other, descriptor.part_id)
	var own: Dictionary = _r04t_source(target_resolver, graph, relation.target_part_id)
	check([donor.canonical_id, donor.canonical] == descriptor.canonical_pair and [own.canonical_id, own.canonical] == relation.target_pair, "Actual source and selected target retain exact recorded canonical pairs.")
	check(([donor.canonical_id, donor.canonical] == [own.canonical_id, own.canonical]) == relation.pair_compatible, "Actual source pair obeys the reviewed canonical-family relation.")
	check((donor.signature == own.signature) == (relation.pair_compatible and donor.text == own.text), "Runtime signature also respects the actual source surface.")
	check(donor.origins == [{"analysis_id": other.id, "part_id": descriptor.part_id}], "Source tile keeps its actual original graph and part.")
	var actual_whole: Dictionary = _r04t_complete(donor_resolver, other)
	check(_r04t_is_exact(actual_whole, other), "Actual donor whole graph retains its own exact lexical/root attribution.")
	var evidence: Dictionary = {"relation": relation, "donor": donor, "target_source": own, "actual_whole": actual_whole}
	if graph.kind != "atomic":
		if relation.pair_compatible:
			var result: Dictionary = _r04t_complete(target_resolver, graph, {relation.target_part_id: donor})
			check(_r04t_is_exact(result, graph) and result.tile.composed and result.tile.mastery_eligible, "Compatible real donor completes the selected multipart target under inspection.")
			check(donor.origins[0] in result.tile.origins and not _r04t_has_analysis(result.tile, other.id, other.roots[0]), "Selected completion retains donor origin without donor completed-root attribution.")
			check(target_resolver.source_tiles(other.id).is_empty() and donor_resolver.source_tiles(graph.id).is_empty(), "Separate source and selected-target catalogs do not relabel _r04t_graphs.")
			check(result.tile.break_offsets == ([7.0] if graph.text == "bubble wrap" else []), "Donor preserves exact selected root boundary metadata.")
			evidence.selected_result = result
		else:
			var combined: Resolver = _r04t_resolver([graph, other], other.review.status == "reviewed")
			var wrong: Dictionary = _r04t_source(combined, other, descriptor.part_id)
			var refused: Dictionary = _r04t_complete(combined, graph, {relation.target_part_id: wrong})
			_r04t_invalid_join(refused, graph)
			evidence.refused_result = refused
	elif relation.pair_compatible and other.kind == "atomic":
		evidence.atomic_collision = _r04t_atomic_collision(graph, other)
	else:
		var combined: Resolver = _r04t_resolver([graph, other], other.review.status == "reviewed")
		var selected: Dictionary = _r04t_source(combined, graph, graph.roots[0])
		var component: Dictionary = _r04t_source(combined, other, descriptor.part_id)
		check(_r04t_is_exact(_r04t_as_result(selected), graph) and not selected.composed and not selected.mastery_eligible, "Selected atomic source is exposure without composition mastery.")
		if relation.pair_compatible and donor.text == own.text:
			check(_r04t_is_exact(_r04t_as_result(component), graph) and not component.composed and not component.mastery_eligible, "Compatible actual component can recognize the atomic selected target without composition mastery.")
			check(_r04t_has_analysis(component, other.id, descriptor.part_id) and not _r04t_has_analysis(component, other.id, other.roots[0]), "Component attribution is distinct from completion of the source compound.")
			var compound: Dictionary = _r04t_complete(combined, other, {descriptor.part_id: selected})
			check(_r04t_is_exact(compound, other) and not _r04t_has_analysis(compound.tile, graph.id, graph.roots[0]), "Band component completes only the source compound root under inspection.")
			check(selected.origins[0] in compound.tile.origins and other.review.status == "pending", "Pending compound keeps the true selected source origin without review promotion.")
			evidence.compound_with_selected_component = compound
		elif relation.pair_compatible:
			check(graph.text == "strap" and descriptor.lexeme_id == "strapping-machine.machine-for-applying-package-bands.n" and component.text == "strapp" and selected.text == "strap", "Actual strapping source retains its doubled-consonant surface.")
			check(component.part_signatures == selected.part_signatures and component.signature != selected.signature, "Shared canonical family does not erase the authored surface distinction.")
			check(_r04t_has_analysis(component, other.id, descriptor.part_id) and not _r04t_has_analysis(component, graph.id, graph.roots[0]) and not component.complete and not component.mastery_eligible, "Strapp component remains partial source recognition without atomic strap completion.")
			var refused: Dictionary = _r04t_complete(combined, other, {descriptor.part_id: selected})
			_r04t_invalid_join(refused, other)
			evidence.surface_substitution_refusal = refused
		else:
			var wrong_atomic: Dictionary = _r04t_complete(combined, graph, {graph.roots[0]: component})
			check(not _r04t_is_exact(wrong_atomic, graph) and not _r04t_has_analysis(component, graph.id, graph.roots[0]) and not component.mastery_eligible, "Distinct actual source cannot recognize selected atomic root or mastery.")
			evidence.wrong_source_recognition = wrong_atomic
			if other.kind != "atomic":
				var refused: Dictionary = _r04t_complete(combined, other, {descriptor.part_id: selected})
				_r04t_invalid_join(refused, other)
				evidence.reverse_substitution_refusal = refused
		check(not _r04t_has_analysis(_r04t_complete(combined, other).tile, graph.id, graph.roots[0]), "Whole actual donor completion does not credit a selected atomic root.")
		evidence.combined_component = component
	check(other == before and graph.review.status == "reviewed", "Relation checks preserve actual source graph and reviewed selected graph.")
	return evidence


func _r04t_case(test: Dictionary) -> Dictionary:
	var graph: Dictionary = _r04t_graphs[test.targets[0].analysis_id]
	check(graph.lexeme_id == test.targets[0].lexeme_id and graph.roots == [test.targets[0].root], "Case binds exact frozen selected identity and root: " + test.id)
	var evidence: Dictionary = {}
	match test.category:
		"candidate_gate_and_exact_graph":
			var before: Dictionary = graph.duplicate(true)
			var ordinary := Resolver.new()
			var authors: Array = _r04t_record.author_candidates.filter(func(candidate: Dictionary) -> bool: return candidate.id == graph.id)
			check(authors.size() == 1 and authors[0].review.status == "pending", "Persisted acceptance retains the exact pending author graph.")
			var rejected: Dictionary = Analysis.compile(authors[0])
			check(not rejected.ok and rejected.error == "Pending morphology cannot be used in a playable round." and not ordinary.configure(authors), "Default admission still rejects the frozen pending author graph.")
			check(graph.review.status == "reviewed" and Analysis.compile(graph).ok and ordinary.configure([graph]), "Exact persisted accepted graph admits without bypass.")
			var admitted: Array = ordinary.source_tiles(graph.id)
			var downgrade: Dictionary = graph.duplicate(true)
			downgrade.review.status = "pending"
			check(not ordinary.configure([downgrade]) and ordinary.source_tiles(graph.id) == admitted and Analysis.compile(authors[0], false).ok, "Pending downgrade preserves admitted catalog; author structure requires explicit inspection.")
			var resolver: Resolver = _r04t_resolver([graph])
			var result: Dictionary = _r04t_complete(resolver, graph)
			var leaves: Array = resolver.source_tiles(graph.id)
			check(_r04t_is_exact(result, graph) and leaves.size() == graph.parts.size(), "Candidate completes exact analysis, actual root, lexical ID and spelling.")
			check(result.tile.break_offsets == ([7.0] if graph.text == "bubble wrap" else []), "Candidate root boundary metadata is exact.")
			check(result.tile.origins.size() == graph.parts.size(), "Candidate completion keeps all source origins.")
			var assisted_results: Array = []
			for part: Dictionary in graph.parts:
				var source: Dictionary = _r04t_source(resolver, graph, part.id)
				check(source.break_offsets == [] and not source.composed and not source.mastery_eligible, "Source leaf has no boundary or composition credit.")
				var assisted: Dictionary = source.duplicate(true)
				assisted.assisted = true
				var helped: Dictionary = _r04t_complete(resolver, graph, {part.id: assisted})
				check(_r04t_is_exact(helped, graph) and helped.tile.assisted and not helped.tile.mastery_eligible and not source.assisted, "Assistance to any actual source suppresses mastery and leaves source unchanged.")
				assisted_results.append({"part_id": part.id, "result": helped})
			if graph.kind == "atomic":
				check(graph.parts.size() == 1 and graph.nodes.is_empty() and not result.tile.composed and not result.tile.mastery_eligible, "Atomic exposure has no invented composition or mastery.")
			else:
				check(result.tile.composed and not result.tile.assisted and result.tile.mastery_eligible, "Unassisted authored composition has an inspection-only mastery flag.")
			check(graph == before and graph.review.independent_review == "completed_exact_graph_at_declared_teaching_depth", "Persisted runtime leaves accepted graph review exact.")
			evidence = {"default_compile": rejected, "sources": leaves, "result": result, "assisted_results": assisted_results, "production_approved": false}
		"actual_growth_atomic_collision":
			evidence = _r04t_atomic_collision(graph, _r04t_graphs[test.source.analysis_id])
		"actual_growth_compound_ambiguity":
			var other: Dictionary = _r04t_graphs[test.source.analysis_id]
			var resolver: Resolver = _r04t_resolver([graph, other], other.review.status == "reviewed")
			var lefts: Array = [_r04t_source(resolver, graph, "p1"), _r04t_source(resolver, other, "part1")]
			var rights: Array = [_r04t_source(resolver, graph, "p2"), _r04t_source(resolver, other, "part2")]
			check(lefts[0].signature == lefts[1].signature and rights[0].signature == rights[1].signature and graph.lexeme_id != other.lexeme_id, "Same ordered zipper sources advertise distinct complete lexical IDs.")
			var results: Array = []
			for a: Dictionary in lefts:
				for b: Dictionary in rights:
					var result: Dictionary = resolver.resolve(a, b)
					_r04t_invalid_join(result, graph, "ambiguous_sense")
					results.append(result)
			var plan: Dictionary = resolver.completion_plan([lefts[0], rights[0]])
			check(results.size() == 4 and resolver.compatible_pairs([lefts[0], rights[0]]).is_empty(), "All four combinations reject and no arbitrary hint exists.")
			check(plan.status == "unavailable" and plan.reason == "no_completion_path" and plan.steps.is_empty(), "Ambiguous zipper has no arbitrary completion plan.")
			evidence = {"left_sources": lefts, "right_sources": rights, "refusals": results, "plan": plan}
		"actual_growth_selected_target":
			var other: Dictionary = _r04t_graphs[test.source.analysis_id]
			var donor_resolver: Resolver = _r04t_resolver([other], true)
			var target_resolver: Resolver = _r04t_resolver([graph])
			var zip: Dictionary = _r04t_source(donor_resolver, other, "part1")
			var suffix: Dictionary = _r04t_source(donor_resolver, other, "part2")
			check(zip.canonical_id == "growth.part.zip.fasten" and suffix.canonical_id == "english.affix.er.agent-instrument", "Actual Growth zipper donor parts keep their fastening and instrument identities.")
			var results: Array = []
			for replacements: Dictionary in [{"p1": zip}, {"p2": suffix}, {"p1": zip, "p2": suffix}]:
				var result: Dictionary = _r04t_complete(target_resolver, graph, replacements)
				check(_r04t_is_exact(result, graph) and result.tile.mastery_eligible and result.tile.break_offsets == [], "Each selected zipper donor combination completes exact doubled-p target.")
				check(not _r04t_has_analysis(result.tile, other.id, other.roots[0]), "Selected target catalog has no donor completed-root attribution.")
				for donor: Dictionary in replacements.values():
					check(donor.origins[0] in result.tile.origins, "Selected zipper result preserves each actual Growth source origin.")
				results.append(result)
			check(target_resolver.source_tiles(other.id).is_empty() and donor_resolver.source_tiles(graph.id).is_empty(), "Separate catalogs retain original graph IDs.")
			evidence = {"actual_zip": zip, "actual_er": suffix, "selected_results": results}
		"actual_source_relation":
			evidence = _r04t_relation(test, graph)
		"spelling_and_forms":
			var outputs: Array = []
			for target: Dictionary in test.targets:
				var selected: Dictionary = _r04t_graphs[target.analysis_id]
				var resolver: Resolver = _r04t_resolver([selected])
				var first: Dictionary = _r04t_source(resolver, selected, "p1")
				var second: Dictionary = _r04t_source(resolver, selected, "p2")
				var result: Dictionary = resolver.resolve(first, second)
				check(_r04t_is_exact(result, selected), "Explicit ordered output preserves exact word spelling.")
				check(result.tile.break_offsets == ([7.0] if selected.text == "bubble wrap" else []), "Parsed bubble-wrap offset is 7.0; suffix words have no boundary.")
				var reversed: Dictionary = resolver.resolve(second, first)
				_r04t_invalid_join(reversed, selected)
				for tile: Dictionary in [first, second]:
					var partial_plan: Dictionary = resolver.completion_plan([tile])
					check(not tile.complete and not tile.mastery_eligible and partial_plan.status == "unavailable" and partial_plan.reason == "no_completion_path", "An isolated constituent cannot complete its target.")
				var plan: Dictionary = resolver.completion_plan([first, second])
				check(plan.status == "complete" and plan.steps.size() == 1 and _r04t_is_exact(_r04t_as_result(plan.tile), selected), "Unambiguous full source set yields only the authored one-step target.")
				if selected.text == "zipper":
					check(first.text == "zip" and second.text == "er" and result.tile.text == "zipper", "Consonant doubling belongs to authored zipper output, not donor relabeling.")
					check(_r04t_selected_rows[selected.lexeme_id].entry.accepted_forms == ["zipper", "zip", "zip fastener"], "Language alternatives remain exact without new _r04t_graphs.")
				elif selected.text == "container":
					check(first.text == "contain" and second.text == "er" and result.tile.text == "container", "Container preserves direct contain plus er output.")
				outputs.append({"result": result, "reversed": reversed, "plan": plan})
			evidence = {"outputs": outputs, "additional_form_graphs_authored": 0}
		"legacy_exact_attribution":
			var observations: Array = []
			for target: Dictionary in test.targets:
				var selected: Dictionary = _r04t_graphs[target.analysis_id]
				var old: Dictionary = _r04t_selected_rows[target.lexeme_id].entry.morphology
				var old_before: Dictionary = old.duplicate(true)
				check(old.review.status == "pending" and not Analysis.compile(old).ok, "Exact old graph stays pending at its actual root.")
				var old_only: Dictionary = _r04t_complete(_r04t_resolver([old], false), old)
				var selected_only: Dictionary = _r04t_complete(_r04t_resolver([selected]), selected)
				check(_r04t_is_exact(old_only, old) and not _r04t_has_analysis(old_only.tile, selected.id, selected.roots[0]), "Old-only completion cannot credit the absent candidate analysis/root.")
				check(_r04t_is_exact(selected_only, selected) and not _r04t_has_analysis(selected_only.tile, old.id, old.roots[0]), "Selected-only completion cannot credit absent old analysis/root.")
				check(old.lexeme_id == selected.lexeme_id and old.text == selected.text and old.id != selected.id and old.roots[0] != selected.roots[0], "Shared lexical ID does not replace analysis plus actual root attribution.")
				var combined: Resolver = _r04t_resolver([selected, old], false)
				var old_combined: Dictionary = _r04t_complete(combined, old)
				var selected_combined: Dictionary = _r04t_complete(combined, selected)
				check(_r04t_is_exact(old_combined, old) and _r04t_is_exact(selected_combined, selected), "Both old and candidate complete only with exact attributable roots.")
				var retained: bool = selected.text in ["bubble wrap", "carton", "cap", "strap"]
				check(_r04t_has_analysis(old_combined.tile, selected.id, selected.roots[0]) == retained and _r04t_has_analysis(selected_combined.tile, old.id, old.roots[0]) == retained, "Only retained complete signatures share terminal attribution.")
				if selected.kind == "atomic":
					check(not old_combined.tile.mastery_eligible and not selected_combined.tile.mastery_eligible, "Old and new atomic exposure has no composition mastery.")
				if selected.text == "bubble wrap":
					check(selected_only.tile.break_offsets == [7.0] and old_combined.tile.break_offsets == [] and selected_combined.tile.break_offsets == [], "Shared old/new state renders only mutually approved boundaries.")
				check(old == old_before and selected.review.status == "reviewed", "Legacy comparison changes no review or graph.")
				observations.append({"old_root": old.roots[0], "candidate_root": selected.roots[0], "retained_signature": retained, "old_only": old_only, "candidate_only": selected_only, "old_combined": old_combined, "candidate_combined": selected_combined})
			check(observations.size() == 9 and _r04t_selected_rows["container.holding-object.n"].entry.morphology == null, "Nine actual legacy _r04t_graphs and absent container graph remain exact.")
			evidence = {"legacy_graphs": observations, "container_prior_graph": null}
		"pedagogical_and_domain_limits":
			var atomics: Array = []
			var domain_holds: Array = []
			var other_domains: Array = []
			for candidate: Dictionary in _r04t_input.candidate_graphs:
				var entry: Dictionary = _r04t_selected_rows[candidate.lexeme_id].entry
				check(entry.review.language == "reviewed" and entry.review.status == ("pending" if entry.review.domain == "pending" else "reviewed"), "Exact existing language and overall review statuses remain separate from pending morphology.")
				if entry.review.domain == "pending":
					domain_holds.append(candidate.text)
				else:
					check(entry.review.domain == "not_required", "No new domain approval is introduced.")
					other_domains.append(candidate.text)
				if candidate.kind == "atomic":
					var result: Dictionary = _r04t_complete(_r04t_resolver([candidate]), candidate)
					check(candidate.parts.size() == 1 and candidate.nodes.is_empty() and _r04t_is_exact(result, candidate) and not result.tile.composed and not result.tile.mastery_eligible, "Whole-current-word teaching depth grants exposure only.")
					atomics.append(result)
			check(atomics.size() == 7 and domain_holds == ["bubble wrap", "carton", "container", "lid", "seal", "strap", "button"] and other_domains == ["cap", "handle", "zipper"], "All seven domain holds and three not-required scopes stay exact.")
			var hand: Dictionary = _r04t_graphs["growth.hand.analysis.v1"]
			var handle_resolver: Resolver = _r04t_resolver([graph, hand])
			var handle: Dictionary = _r04t_source(handle_resolver, graph, "whole")
			var body_part: Dictionary = _r04t_source(handle_resolver, hand, "whole")
			check(handle.signature != body_part.signature and not _r04t_has_analysis(handle, hand.id, hand.roots[0]), "Current grip noun exposure is distinct from actual body-part hand.")
			var refused: Dictionary = handle_resolver.resolve(handle, body_part)
			_r04t_invalid_join(refused, graph)
			for decision: Dictionary in _r04t_input.independent_decisions:
				check(decision.decision == "accept_at_declared_teaching_depth" and not decision.production_acceptance and not decision.retained_uncertainty.is_empty(), "Independent depth acceptance preserves uncertainty and no production admission.")
			evidence = {"atomic_exposures": atomics, "domain_holds": domain_holds, "not_required_domains": other_domains, "actual_hand": body_part, "handle_plus_hand_refusal": refused, "frozen_teaching_boundaries": _r04t_input.teaching_boundaries, "independent_decisions": _r04t_input.independent_decisions}
		_:
			check(false, "Unhandled frozen case category: " + test.category)
	return evidence



func _check_retail04_third10() -> void:
	_r04t_record = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/retail-module04-morphology-third10-2026-10-16.json"))
	_r04t_graphs.clear()
	_r04t_selected_rows.clear()
	_r04t_input = {"candidate_graphs": [], "independent_decisions": _r04t_record.independent_decisions.decisions, "teaching_boundaries": _r04t_record.independent_decisions.decisions}
	for patch: Dictionary in _r04t_record.patches:
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(patch.origin))
		var actual: Array = document.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == patch.id)
		check(actual.size() == 1 and actual[0] == patch.after, "Retail04 third-ten current complete record equals exact accepted output: " + patch.id)
		if actual.size() != 1:
			return
		var graph: Dictionary = actual[0].morphology
		check(graph.review.status == "reviewed" and Analysis.compile(graph).ok, "Retail04 third-ten production graph admits under default compiler gate.")
		_r04t_graphs[graph.id] = graph
		_r04t_input.candidate_graphs.append(graph)
		_r04t_selected_rows[patch.id] = {"entry": patch.before}
		if patch.before.morphology != null:
			_r04t_graphs[patch.before.morphology.id] = patch.before.morphology
	for row: Dictionary in _r04t_record.protected_related_entries:
		var document: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(row.resource))
		var actual: Array = document.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == row.entry.id)
		check(actual.size() == 1 and actual[0] == row.entry, "Retail04 third-ten actual protected source remains exact: " + row.entry.id)
		if row.entry.morphology != null:
			_r04t_graphs[row.entry.morphology.id] = row.entry.morphology
	var words: Array = JSON.parse_string(FileAccess.get_file_as_string("res://words.json"))
	var growth_count: int = 0
	Growth.clear_cache()
	for row: Dictionary in _r04t_record.protected_growth_entries:
		var matches: Array = words.filter(func(word: Dictionary) -> bool: return word.id == row.entry.id)
		var frozen_words: Array = _r04t_record.protected_growth_dependency_supplement.actual_growth_words.filter(func(item: Dictionary) -> bool: return item.entry_id == row.entry.id)
		var cohort: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://" + row.resource))
		var actual: Array = cohort.entries.filter(func(entry: Dictionary) -> bool: return entry.id == row.entry.id)
		check(matches.size() == 1 and frozen_words.size() == 1 and matches[0] == frozen_words[0].word and actual.size() == 1 and actual[0] == row.entry, "Retail04 third-ten actual Growth word and indexed record remain exact.")
		if matches.size() != 1:
			return
		var decorated: Dictionary = Growth.decorate(matches[0])
		var expected: Dictionary = row.entry.analysis.duplicate(true)
		expected.review = row.entry.review.duplicate(true)
		check(decorated.get("morphology_status") == "reviewed" and decorated.get("morphology") == expected and Analysis.compile(expected).ok, "Retail04 third-ten real Growth.decorate retains exact analysis and review.")
		_r04t_graphs[expected.id] = decorated.morphology
		var completed: Dictionary = _r04t_complete(_r04t_resolver([decorated.morphology]), decorated.morphology)
		check(_r04t_is_exact(completed, decorated.morphology), "Retail04 third-ten actual Growth standalone completion has its original root.")
		growth_count += 1
	check(growth_count == 12 and _r04t_input.candidate_graphs.size() == 10, "Retail04 third-ten all twelve actual Growth records and ten accepted targets inspected.")
	var counts: Dictionary = {}
	var case_ids: Array = []
	for test: Dictionary in _r04t_record.runtime_case_proposal.cases:
		var evidence: Dictionary = _r04t_case(test)
		check(not evidence.is_empty(), "Retail04 third-ten persisted frozen case executes: " + test.id)
		case_ids.append(test.id)
		counts[test.category] = int(counts.get(test.category, 0)) + 1
	var expected_counts: Dictionary = {}
	for category: String in _r04t_record.runtime_case_proposal.case_counts:
		var number: Variant = _r04t_record.runtime_case_proposal.case_counts[category]
		check((number is int or number is float) and float(number) == float(int(number)), "Retail04 third-ten expected case count is an exact integer.")
		expected_counts[category] = int(number)
	check(case_ids.size() == 54 and case_ids == _r04t_record.runtime_case_proposal.cases.map(func(row: Dictionary) -> String: return row.id) and counts == expected_counts, "Retail04 third-ten all frozen cases and categories execute in exact order.")
	check(_r04t_resolver(_r04t_input.candidate_graphs).source_tiles(_r04t_input.candidate_graphs[0].id).size() == 2, "Retail04 third-ten entire reviewed batch admits normally.")


var _f02s_language_record: Dictionary = {}

func _f02s_reverse(entry: Dictionary) -> Dictionary:
	var third_language: Dictionary = _f02t_reverse(entry)
	if not third_language.ok:
		return {"ok": false}
	entry = third_language.entry
	if _f02s_language_record.is_empty():
		_f02s_language_record = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module02-language-second10-2026-10-17.json"))
	var patches: Array = _f02s_language_record.patches.filter(func(patch: Dictionary) -> bool: return patch.id == entry.get("id", ""))
	if patches.is_empty():
		return {"ok": true, "entry": entry}
	if patches.size() != 1:
		return {"ok": false}
	var patch: Dictionary = patches[0]
	if entry != patch.before and entry != patch.after:
		return {"ok": false}
	return {"ok": true, "entry": patch.before.duplicate(true)}

func _check_foundation02_second_language() -> void:
	_f02s_language_record = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module02-language-second10-2026-10-17.json"))
	var envelope: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/lexemes/foundation-module02.json"))
	check(_f02s_language_record.patches.size() == 8 and _f02s_language_record.held.size() == 2, "Foundation02 second-ten has eight accepted lexical deltas and two whole-entry holds")
	for patch: Dictionary in _f02s_language_record.patches:
		var rows: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == patch.id)
		check(rows.size() == 1 and rows[0] == patch.after, "Foundation02 second-ten live entry equals exact accepted language output: " + patch.id)
		if rows.size() != 1:
			continue
		check(rows[0].morphology == patch.before.morphology and rows[0].morphology.review.status == "pending" and not Analysis.compile(rows[0].morphology).ok, "Foundation02 language acceptance cannot admit pending morphology: " + patch.id)
		check(rows[0].media == patch.before.media and rows[0].review.domain == patch.before.review.domain, "Foundation02 language acceptance preserves exact media and domain gates: " + patch.id)
		for state: Dictionary in [patch.before, patch.after]:
			var reversed: Dictionary = _f02s_reverse(state)
			check(reversed.ok and reversed.entry == patch.before, "Foundation02 exact historical and accepted states reverse chronologically: " + patch.id)
			for field: String in ["definition", "example", "difficulty", "review", "references", "editorial_notes", "media", "morphology", "accepted_forms", "regions", "extra"]:
				var changed: Dictionary = state.duplicate(true)
				match field:
					"review": changed.review.domain = "reviewed"
					"references": changed.references[0].scope += " Drift."
					"media": changed.media.audio.voice = "unexpected"
					"morphology": changed.morphology.review.status = "reviewed"
					"accepted_forms", "regions": changed[field].append("unexpected")
					"extra": changed.extra = true
					_: changed[field] += " Drift."
				check(not _f02s_reverse(changed).ok, "Foundation02 chronology rejects unrecognized field drift: " + patch.id + "/" + field)
		var independent: Dictionary = _f02s_reverse(patch.after)
		independent.entry.definition = "clone only"
		check(patch.before.definition != "clone only", "Foundation02 reversal returns an independent historical clone")
	for held: Dictionary in _f02s_language_record.held:
		var rows: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == held.id)
		check(rows.size() == 1 and rows[0] == held.value and rows[0].review.language == "pending", "Foundation02 unresolved entry stays exact: " + held.id)
	for donor: Array in [["retail-module03-morphology-fourth10-2026-10-16.json", "return.send-back.v"], ["retail-module04-morphology-first10-2026-10-16.json", "arrange.organize.v"]]:
		var history: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/" + donor[0]))
		var snapshots: Array = history.protected_related_entries.filter(func(row: Dictionary) -> bool: return row.entry.id == donor[1])
		var rows: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == donor[1])
		check(snapshots.size() == 1 and rows.size() == 1, "Foundation02 historical donor identity remains unique: " + donor[1])
		if snapshots.size() == 1 and rows.size() == 1:
			var reversed: Dictionary = _f02s_reverse(rows[0])
			check(reversed.ok and reversed.entry == snapshots[0].entry and rows[0].morphology == snapshots[0].entry.morphology, "Foundation02 exact language reversal preserves the pending historical donor: " + donor[1])


var _f02t_language_record: Dictionary = {}

func _f02t_reverse(entry: Dictionary) -> Dictionary:
	if _f02t_language_record.is_empty():
		_f02t_language_record = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module02-language-third10-2026-10-17.json"))
	var patches: Array = _f02t_language_record.patches.filter(func(patch: Dictionary) -> bool: return patch.id == entry.get("id", ""))
	if patches.is_empty():
		return {"ok": true, "entry": entry}
	if patches.size() != 1:
		return {"ok": false}
	var patch: Dictionary = patches[0]
	if entry != patch.before and entry != patch.after:
		return {"ok": false}
	return {"ok": true, "entry": patch.before.duplicate(true)}

func _check_foundation02_third_language() -> void:
	_f02t_language_record = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/provenance/foundation-module02-language-third10-2026-10-17.json"))
	var envelope: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/professional/lexemes/foundation-module02.json"))
	check(_f02t_language_record.patches.size() == 8 and _f02t_language_record.held.size() == 2, "Foundation02 third-ten has eight language decisions and two new whole-entry holds")
	for patch: Dictionary in _f02t_language_record.patches:
		var rows: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == patch.id)
		check(rows.size() == 1 and rows[0] == patch.after, "Third-ten live entry equals the exact delivered projection: " + patch.id)
		if rows.size() != 1:
			continue
		check(rows[0].morphology == patch.before.morphology and rows[0].morphology.review.status == "pending" and not Analysis.compile(rows[0].morphology).ok, "Language approval cannot admit pending morphology: " + patch.id)
		check(rows[0].media == patch.before.media and rows[0].review.domain == patch.before.review.domain, "Third-ten preserves exact media and domain gates: " + patch.id)
		for state: Dictionary in [patch.before, patch.after]:
			var reversed: Dictionary = _f02t_reverse(state)
			check(reversed.ok and reversed.entry == patch.before, "Third-ten exact historical and accepted states reverse: " + patch.id)
			for field: String in ["definition", "example", "difficulty", "review", "references", "editorial_notes", "media", "morphology", "accepted_forms", "regions", "practice_modes", "extra"]:
				var changed: Dictionary = state.duplicate(true)
				match field:
					"review": changed.review.domain = "reviewed"
					"references": changed.references[0].scope += " Drift."
					"media": changed.media.audio.voice = "unexpected"
					"morphology": changed.morphology.review.status = "reviewed"
					"accepted_forms", "regions", "practice_modes": changed[field].append("unexpected")
					"extra": changed.extra = true
					_: changed[field] += " Drift."
				check(not _f02t_reverse(changed).ok and not _f02s_reverse(changed).ok, "Third-ten and earlier chronology reject field drift: " + patch.id + "/" + field)
		var independent: Dictionary = _f02t_reverse(patch.after)
		independent.entry.definition = "clone only"
		check(patch.before.definition != "clone only", "Third-ten returns an independent historical clone")
	for held: Dictionary in _f02t_language_record.held:
		var rows: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == held.id)
		check(rows.size() == 1 and rows[0] == held.value and rows[0].review.language == "pending", "Third-ten held entry stays exact: " + held.id)
	for held: Dictionary in _f02t_language_record.protected_context.prior_lexical_holds:
		var rows: Array = envelope.lexemes.filter(func(entry: Dictionary) -> bool: return entry.id == held.id)
		check(rows.size() == 1 and rows[0] == held.before_entry and rows[0].review.language == "pending", "Prior lexical hold stays exact: " + held.id)
