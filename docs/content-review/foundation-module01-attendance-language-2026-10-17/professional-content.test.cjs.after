function beforeAttendanceLanguage(entry) {
  const patch = attendanceLanguageRecord.patches.find(item => item.id === entry.id);
  if (!patch) return entry;
  // Only exact historical or later accepted entries may cross this chronology boundary.
  if (require('node:util').isDeepStrictEqual(entry, patch.before)) return structuredClone(patch.before);
  assert.deepEqual(entry, patch.after, entry.id + ': exact later independently accepted attendance language and metadata delta');
  return structuredClone(patch.before);
}
function beforeFoundation02FirstLanguage(entry) {
  entry = beforeAttendanceLanguage(entry);
  const patch = foundation02FirstLanguageRecord.patches.find(item => item.id === entry.id);
  if (!patch) return entry;
  // Exact earlier snapshots remain valid; arbitrary partial or later edits do not.
  if (require('node:util').isDeepStrictEqual(entry, patch.before)) return structuredClone(patch.before);
  assert.deepEqual(entry, patch.after, entry.id + ': exact later module02 first-ten language and metadata delta');
  return structuredClone(patch.before);
}
function beforeSupervisorLanguage(entry) {
  entry = beforeFoundation02FirstLanguage(entry);
  const patch = supervisorLanguageRecord.patches.find(item => item.id === entry.id);
  if (!patch) return entry;
  // Historical snapshots can already contain the exact held entry. Both states remain fully checked.
  if (require('node:util').isDeepStrictEqual(entry, patch.before)) return structuredClone(patch.before);
  assert.deepEqual(entry, patch.after, entry.id + ': exact later independently reviewed supervisor language delta');
  return structuredClone(patch.before);
}
function beforeFoundationFifthLanguage(entry) {
  entry = beforeSupervisorLanguage(entry);
  const patch = foundationFifthLanguageRecord.patches.find(item => item.id === entry.id);
