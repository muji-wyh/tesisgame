test('an unknown module file and unknown sense cannot escape catalog validation', () => {
  const data = draft();
  pilot(data).lexeme_files.push('res://data/professional/lexemes/unknown.json');
  pilot(data).lexeme_ids[0] = 'unknown.sense.n';
