  assert.deepEqual(r.new_canonical_pairs,[['morph.part.contain.hold-within','contain'],['morph.part.seal.package-closure','seal'],['morph.part.handle.grip','handle']]);assert.deepEqual(r.canonical_migrations,[]);
  for(const [text,id]of Object.entries({carton:'morph.carton',lid:'growth.lid',cap:'morph.cap',seal:'morph.part.seal.package-closure',handle:'morph.part.handle.grip',strap:'morph.strap',button:'growth.button'})){assert.deepEqual(pairs(text),[[id,text]]);assert.deepEqual(graph(text).nodes,[]);assert.deepEqual(graph(text).roots,['whole']);}
  assert.deepEqual(pairs('bubble wrap'),[['morph.bubble','bubble'],['morph.wrap','wrap']]);assert.deepEqual(graph('bubble wrap').nodes,[{id:'whole',left:'p1',right:'p2',surface:'bubble wrap',rule:'bubble-plus-wrap-word-boundary',break_offsets:[7]}]);
  assert.deepEqual(pairs('container'),[['morph.part.contain.hold-within','contain'],['english.affix.er.agent-instrument','-er']]);assert.deepEqual(graph('container').nodes,[{id:'whole',left:'p1',right:'p2',surface:'container',rule:'contain-plus-instrument-er',break_offsets:[]}]);
  assert.deepEqual(pairs('zipper'),[['growth.part.zip.fasten','zip'],['english.affix.er.agent-instrument','-er']]);assert.deepEqual(graph('zipper').nodes,[{id:'whole',left:'p1',right:'p2',surface:'zipper',rule:'zip-fasten-plus-instrument-er-double-p',break_offsets:[]}]);
  assert.deepEqual(r.patches.find(p=>p.after.text==='zipper').after.accepted_forms,['zipper','zip','zip fastener']);assert.deepEqual(r.patches.filter(p=>p.before.morphology===null).map(p=>p.after.text),['container']);
  const handle=r.independent_decisions.decisions.find(d=>d.text==='handle'),zipper=r.independent_decisions.decisions.find(d=>d.text==='zipper');
  assert.match(handle.retained_uncertainty,/historical hand plus instrumental el/);assert.equal(handle.composition_mastery_allowed_by_editorial_review,false);assert.match(zipper.retained_uncertainty,/back-formation/);assert.match(zipper.retained_uncertainty,/not historical derivational order/);
  assert.ok(r.independent_decisions.decisions.every(d=>d.production_acceptance===false&&d.retained_uncertainty));
  const relations=r.runtime_case_proposal.cases.filter(c=>c.category==='actual_source_relation').map(c=>c.source);assert.equal(relations.length,37);
  for(const relation of relations){const source=relation.source.source==='actual_growth'?r.protected_growth_entries.find(row=>row.entry.id===relation.source.lexeme_id).entry.analysis:r.protected_related_entries.find(row=>row.entry.id===relation.source.lexeme_id).entry.morphology;assert.equal(source.id,relation.source.analysis_id);assert.deepEqual(source.roots,[relation.source.root]);const part=source.parts.find(p=>p.id===relation.source.part_id);assert.deepEqual([part.canonical_id,part.canonical],relation.source.canonical_pair);assert.equal(hash(relation.target_pair)===hash(relation.source.canonical_pair),relation.pair_compatible);}
  const strapping=relations.find(row=>row.source.lexeme_id==='strapping-machine.machine-for-applying-package-bands.n');assert.equal(strapping.pair_compatible,true);const strappingSource=r.protected_related_entries.find(row=>row.entry.id===strapping.source.lexeme_id).entry.morphology.parts.find(p=>p.id===strapping.source.part_id);assert.equal(strappingSource.surface,'strapp');assert.equal(graph('strap').parts[0].surface,'strap');
  const unbutton=relations.find(row=>row.source.lexeme_id==='unbutton');assert.equal(unbutton.pair_compatible,false);assert.deepEqual(unbutton.source.canonical_pair,['growth.part.button.action','button']);
  assert.equal(data.courses.find(c=>c.id==='retail').modules.find(m=>m.id==='module04').lexeme_ids.filter(id=>data.lexemes.find(e=>e.id===id).morphology?.review.status==='reviewed').length,30);
});

test('Retail04 third ten historical reversal rejects any unrelated entry drift', () => {
  for(const patch of retail04ThirdRecord.patches){assert.deepEqual(beforeRetail04Third10(patch.after),patch.before);const wrongDefinition=structuredClone(patch.after);wrongDefinition.definition+=' Unexpected change.';assert.throws(()=>beforeRetail04Third10(wrongDefinition));const wrongGraph=structuredClone(patch.after);wrongGraph.morphology.review.status='pending';assert.throws(()=>beforeRetail04Third10(wrongGraph));const wrongMedia=structuredClone(patch.after);wrongMedia.media.image.status='rejected';assert.throws(()=>beforeRetail04Third10(wrongMedia));}
});

test('Retail04 third ten alter morphology only and preserve context, source, Growth and domain gates', () => {
  const r=retail04ThirdRecord,withoutMorphology=e=>Object.fromEntries(Object.entries(e).filter(([k])=>k!=='morphology'));
  for(const patch of r.patches){const actual=data.lexemes.find(e=>e.id===patch.id);assert.deepEqual(actual,patch.after);assert.equal(hash(patch.before),patch.before_sha256);assert.deepEqual(withoutMorphology(actual),withoutMorphology(patch.before));assert.equal(hash(withoutMorphology(actual)),patch.protected_fields_sha256);assert.equal(actual.editorial_notes,patch.before.editorial_notes);assert.deepEqual(morphologyErrors(actual.morphology,actual),[]);assert.equal(actual.morphology.review.status,'reviewed');assert.ok(actual.morphology.review.source_record_ids.every(id=>r.sources.some(s=>s.id===id)));}
  assert.equal(r.protected_related_entries.length,39);for(const row of r.protected_related_entries)assert.deepEqual(data.lexemes.find(e=>e.id===row.entry.id),row.entry);
  assert.equal(r.protected_modules.length,62);for(const row of r.protected_modules)assert.equal(hash(data.courses.find(c=>c.id===row.course_id).modules.find(m=>m.id===row.module_id)),row.json_sha256);
  assert.equal(r.protected_expressions.length,620);for(const row of r.protected_expressions)assert.equal(hash(data.expressions.find(e=>e.id===row.entry.id)),row.json_sha256);
  assert.equal(r.protected_existing_sources.length,197);for(const row of r.protected_existing_sources)assert.deepEqual(data.sources.find(s=>s.id===row.source.id),row.source);
  for(const expected of r.sources){assert.deepEqual(data.sources.find(s=>s.id===expected.id),expected);assert.equal(expected.status,'consulted');assert.equal(expected.assets_acquired,false);assert.equal(expected.asset_license,null);}
  for(const row of r.protected_growth_entries)assert.deepEqual(JSON.parse(fs.readFileSync(path.join(root,row.resource))).entries.find(e=>e.id===row.entry.id),row.entry);
  const raw=file=>crypto.createHash('sha256').update(fs.readFileSync(path.join(root,file))).digest('hex');for(const [file,sha]of Object.entries(r.protected_growth_raw_sha256))assert.equal(raw(file),sha);
  const supplement=r.protected_growth_dependency_supplement;assert.equal(raw(supplement.growth_index.resource),supplement.growth_index.raw_sha256);const words=JSON.parse(fs.readFileSync(path.join(root,'words.json')));for(const row of supplement.actual_growth_words)assert.deepEqual(words.find(w=>w.id===row.entry_id),row.word);
  assert.equal(r.selected_memberships.reduce((n,row)=>n+row.memberships.length,0),24);for(const row of r.selected_memberships)assert.deepEqual(data.courses.flatMap(c=>c.modules.filter(m=>m.lexeme_ids.includes(row.id)).map(m=>({course_id:c.id,module_id:m.id}))),row.memberships);
  assert.equal(r.patches.filter(p=>p.after.review.domain==='pending').length,7);assert.deepEqual(r.patches.filter(p=>p.after.review.domain==='not_required').map(p=>p.after.text),['cap','handle','zipper']);assert.ok(data.courses.every(c=>c.modules.every(m=>m.status==='draft')));
});



test('Fourth-ten Foundation reversal preserves exact historical Retail donor snapshots', () => {
  for(const [id,record]of [['greeting.welcome-message.n',fifthRecord],['announcement.public-message.n',retail04FirstRecord]]){
    const patch=foundationFourthLanguageRecord.patches.find(p=>p.id===id),entry=data.lexemes.find(e=>e.id===id),historical=record.protected_related_entries.find(row=>row.entry.id===id);
    assert.deepEqual(entry,patch.after);assert.deepEqual(beforeFoundationFourthLanguage(entry),patch.before);assert.deepEqual(beforeFoundationLanguage(entry),historical.entry);assert.deepEqual(entry.morphology,historical.entry.morphology);assert.equal(entry.morphology.review.status,'pending');
    const wrong=structuredClone(entry);wrong.morphology.review.status='reviewed';assert.throws(()=>beforeFoundationFourthLanguage(wrong));
  }
  for(const patch of foundationFourthLanguageRecord.patches){assert.deepEqual(data.lexemes.find(e=>e.id===patch.id).morphology,patch.before.morphology);assert.equal(patch.after.morphology.review.status,'pending');}
});

test('cash-register historical image reversal rejects all unrelated full-entry drift',()=>{
  const patch=cashRegisterImageRecord.patches[0];assert.deepEqual(beforeCashRegisterImage(patch.after),patch.before);assert.throws(()=>beforeCashRegisterImage(patch.before));
  for(const mutate of [e=>e.definition+=' Unexpected change.',e=>e.media.audio.sha256='0'.repeat(64),e=>e.morphology.review.status='pending',e=>e.review.domain='reviewed',e=>e.editorial_notes+=' Unexpected note.',e=>e.media.image.brief+=' Unexpected brief.']){const wrong=structuredClone(patch.after);mutate(wrong);assert.throws(()=>beforeCashRegisterImage(wrong));}
});


test('Fifth-ten Foundation language acceptance preserves all ten pending morphology graphs', () => {
  for (const patch of foundationFifthLanguageRecord.patches) {
    const entry = data.lexemes.find(e => e.id === patch.id);
    assert.deepEqual(entry, patch.after); assert.deepEqual(entry.morphology, patch.before.morphology); assert.equal(entry.morphology.review.status, 'pending');
    assert.deepEqual(entry.references.slice(0, patch.before.references.length), patch.before.references);
    assert.deepEqual(beforeFoundationFifthLanguage(entry), patch.before); assert.deepEqual(beforeFoundationLanguage(entry), patch.before);
    for (const mutate of [e => {e.morphology.review.status = 'reviewed';}, e => {e.references[0].scope += ' Unexpected.';}, e => {e.accepted_forms.push('unexpected');}]) {
      const changed = structuredClone(entry); mutate(changed); assert.throws(() => beforeFoundationFifthLanguage(changed));
    }
  }
});

test('Supervisor language reversal retains exact pending morphology and rejects graph or identity drift', () => {
  const p=supervisorLanguageRecord.patches[0], entry=data.lexemes.find(e=>e.id===p.id);
  assert.deepEqual(entry,p.after); assert.deepEqual(entry.morphology,p.before.morphology); assert.equal(entry.morphology.review.status,'pending');
  assert.deepEqual(beforeFoundationLanguage(entry),p.before); assert.deepEqual(beforeFoundationLanguage(p.before),p.before);
  for (const state of [p.before,p.after]) for (const change of [e=>{e.morphology.review.status='reviewed';},e=>{e.morphology.parts[0].canonical_id+='unexpected';},e=>{e.media.audio.voice='unexpected';},e=>{e.accepted_forms.push('unexpected');}]) {
    const altered=structuredClone(state); change(altered); assert.throws(()=>beforeSupervisorLanguage(altered));
  }
});


test('Module02 language reversal preserves exact pending morphology and rejects identity or graph drift', () => {
  for(const p of foundation02FirstLanguageRecord.patches){
    const entry=data.lexemes.find(e=>e.id===p.id);assert.deepEqual(entry,p.after);assert.deepEqual(entry.morphology,p.before.morphology);assert.equal(entry.morphology.review.status,'pending');
    for(const state of [p.before,p.after]){
      assert.deepEqual(beforeFoundationLanguage(state),p.before);
      for(const change of [e=>{e.morphology.review.status='reviewed';},e=>{e.morphology.parts[0].canonical_id+='unexpected';},e=>{e.morphology.text+='unexpected';},e=>{e.media.audio.voice='unexpected';},e=>{e.accepted_forms.push('unexpected');},e=>{e.id+='unexpected';}]){
        const altered=structuredClone(state);change(altered);if(altered.id===p.id)assert.throws(()=>beforeFoundation02FirstLanguage(altered));else assert.notDeepEqual(beforeFoundationLanguage(altered),p.before);
      }
    }
  }
});


