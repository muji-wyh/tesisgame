test('Retail04 first ten bind exact author, independent, native and root decisions', () => {
  const r = retail04FirstRecord, approval = r.independent_approval;
  assert.equal(approval.status, 'root_accepts_exact_morphology_candidates_pending_guarded_integration');
  assert.equal(approval.author_ledger_json_sha256, '7b37697afbdb128515070a75f176ae799a96f906f2c849bb4fb9027a3f9634e6');
  assert.equal(approval.independent_decisions.json_sha256, '4f3c25c5bc8dcb1d3c186e5115543974933ece4b46d31274c066316f258ed085');
  assert.equal(hash(r.independent_decisions), approval.independent_decisions.json_sha256);
  assert.equal(hash(r.source_consultation_ledger), r.author_evidence.source_ledger_json_sha256);
  assert.equal(r.patches.length, 10); assert.equal(r.sources.length, 24);
  const raw = file => crypto.createHash('sha256').update(fs.readFileSync(path.join(root, file))).digest('hex');
  assert.equal(raw(r.acceptance_evidence.path), 'cf7af9b291a37db9b4f58cb83b4da15c41663d4aab9b4af59c34f69028358caf');
  assert.equal(raw(r.acceptance_evidence.path), r.acceptance_evidence.raw_sha256);
  assert.equal(raw(r.native_probe.path), '8052564a73e54f578aac12264fc7b2710aef34034e4c4fae98583af972ec3afa');
  const native = JSON.parse(fs.readFileSync(path.join(root, r.native_probe.path)));
  assert.equal(native.status, 'scratch_native_checks_passed_not_production_acceptance');
  assert.equal(native.native.checks, 317); assert.deepEqual(native.native.failures, []);
  assert.equal(native.proposal_json_sha256, approval.author_ledger_json_sha256);
  assert.equal(native.independent_decisions_json_sha256, approval.independent_decisions.json_sha256);
  assert.equal(raw(r.production_validation.path), r.production_validation.raw_sha256);
  const validation = JSON.parse(fs.readFileSync(path.join(root, r.production_validation.path)));
  assert.equal(validation.ok, true); assert.equal(validation.registry_after_sha256, r.integration.before_registry_sha256);
  for (const [index, patch] of r.patches.entries()) {
    assert.equal(approval.decisions[index].id, patch.id);
    assert.equal(approval.decisions[index].candidate_json_sha256, patch.original_candidate_json_sha256);
    assert.equal(approval.decisions[index].decision, 'accept_at_declared_teaching_depth');
    assert.equal(r.independent_decisions.decisions[index].decision, 'accept_at_declared_teaching_depth');
    const candidate = structuredClone(patch.after.morphology);
    candidate.review.status = 'pending'; candidate.review.independent_review = 'not_completed';
    for (const key of ['reviewer','reviewed_at','acceptance_record']) delete candidate.review[key];
    assert.equal(hash(candidate), patch.original_candidate_json_sha256);
  }
});

test('Retail04 changes morphology only and preserves complete family, course and source scope', () => {
  const r = retail04FirstRecord, nonMorphology = entry => Object.fromEntries(Object.entries(entry).filter(([key]) => key !== 'morphology'));
  for (const patch of r.patches) {
    const actual = data.lexemes.find(entry => entry.id === patch.id);
    assert.deepEqual(actual, patch.after); assert.equal(hash(patch.before), patch.before_sha256);
    assert.equal(hash(nonMorphology(patch.before)), patch.protected_fields_sha256);
    assert.deepEqual(nonMorphology(actual), nonMorphology(patch.before));
    assert.equal(actual.editorial_notes, patch.before.editorial_notes);
    assert.deepEqual(morphologyErrors(actual.morphology, actual), []);
    assert.equal(actual.morphology.review.status, 'reviewed');
    for (const id of actual.morphology.review.source_record_ids) assert.ok(r.sources.some(s => s.id === id));
  }
  for (const expected of r.sources) {
    assert.deepEqual(data.sources.find(s => s.id === expected.id), expected);
    assert.equal(expected.status, 'consulted'); assert.equal(expected.assets_acquired, false); assert.equal(expected.asset_license, null);
  }
  assert.equal(r.protected_related_entries.length, 215);
  for (const row of r.protected_related_entries) assert.deepEqual(beforeFoundationSecondLanguage(data.lexemes.find(e => e.id === row.entry.id)), row.entry);
  for (const row of r.protected_modules) assert.equal(hash(data.courses.find(c => c.id === row.course_id).modules.find(m => m.id === row.module_id)), row.json_sha256);
  for (const row of r.protected_expressions) assert.equal(hash(data.expressions.find(e => e.id === row.entry.id)), row.json_sha256);
  for (const row of r.protected_existing_sources) assert.deepEqual(data.sources.find(s => s.id === row.source.id), row.source);
  for (const row of r.protected_growth_entries) assert.deepEqual(JSON.parse(fs.readFileSync(path.join(root, row.resource))).entries.find(e => e.id === row.entry.id), row.entry);
  for (const [file, expected] of Object.entries(r.protected_growth_raw_sha256)) assert.equal(crypto.createHash('sha256').update(fs.readFileSync(path.join(root, file))).digest('hex'), expected);
  assert.equal(r.selected_memberships.reduce((n, row) => n + row.memberships.length, 0), 24);
  for (const row of r.selected_memberships) assert.deepEqual(data.courses.flatMap(c => c.modules.filter(m => m.lexeme_ids.includes(row.id)).map(m => c.id + '/' + m.id)).sort(), row.memberships.map(m => m.course_id + '/' + m.module_id).sort());
  assert.equal(r.patches.filter(p => p.after.review.domain === 'pending').length, 8);
  assert.ok(data.courses.every(c => c.modules.every(m => m.status === 'draft')));
});

test('Retail04 records nine exposure-only roots, exact result-ment, new pairs and unchanged family boundaries', () => {
  const r = retail04FirstRecord, graph = text => r.patches.find(p => p.after.text === text).after.morphology;
  assert.equal(r.patches.filter(p => p.after.morphology.kind === 'atomic').length, 9);
  assert.deepEqual(r.new_canonical_pairs, [['morph.merchandise','merchandise'],['morph.assort','assort'],['morph.variant','variant']]);
  assert.deepEqual(r.canonical_migrations, []);
  assert.deepEqual(graph('assortment').parts.map(p => [p.canonical_id,p.canonical,p.surface]), [['morph.assort','assort','assort'],['english.affix.ment.result','-ment','ment']]);
  assert.deepEqual(graph('assortment').nodes, [{id:'whole',left:'p1',right:'p2',surface:'assortment',rule:'assort-plus-result-ment',break_offsets:[]}]);
  assert.deepEqual(graph('fabric').parts.map(p => [p.canonical_id,p.canonical]), [['growth.fabric','fabric']]);
  assert.deepEqual(graph('material').parts.map(p => [p.canonical_id,p.canonical]), [['growth.material','material']]);
  const oldFabric = r.patches.find(p => p.after.text === 'fabric').before.morphology;
  assert.deepEqual(oldFabric.parts.map(p => [p.canonical_id,p.canonical]), [['morph.fabric','fabric']]);
  assert.notEqual(oldFabric.id, graph('fabric').id); assert.equal(oldFabric.lexeme_id, graph('fabric').lexeme_id);
  const colour = r.patches.find(p => p.after.text === 'color').after;
  assert.ok(colour.accepted_forms.includes('colour')); assert.equal(colour.morphology.text, 'color'); assert.equal(colour.morphology.parts[0].surface, 'color');
  for (const text of ['product','variant','material']) assert.ok(r.independent_decisions.decisions.find(d => d.id === r.patches.find(p => p.after.text === text).id).teaching_depth_uncertainty.length > 50);
});

test('Retail04 second ten require exact independent evidence, root decision and committed integration', () => {
  const r=retail04SecondRecord, approval=r.independent_approval;
  const raw=file=>crypto.createHash('sha256').update(fs.readFileSync(path.join(root,file))).digest('hex');
  assert.equal(approval.status,'root_accepts_exact_morphology_candidates_pending_guarded_integration');
  assert.equal(approval.root_review_recorded,true);assert.match(approval.reviewer,/^Codex root/);
  assert.equal(approval.author_ledger_json_sha256,'e12ada75767c7b43a0b1132f4ed8ae02d36c6acd9c7a71a8cf48ee0de42c4855');
  assert.equal(hash(r.independent_decisions),'6f6ac9a57e6d48511e1643187cae382f6ecc900fcd37a416325a55774626ac44');
  assert.equal(hash(r.independent_decisions),approval.independent_decisions.json_sha256);
  assert.equal(raw(r.acceptance_evidence.path),r.acceptance_evidence.raw_sha256);
  assert.equal(hash(r.source_consultation_ledger),r.author_evidence.source_ledger_json_sha256);
  assert.equal(r.patches.length,10);assert.equal(r.author_candidates.length,10);assert.equal(r.sources.length,24);
  const delivery='build/professional-english/retail-module04-morphology-review/second10/delivery-r01/';
  assert.equal(raw(delivery+'acceptance-proposal.json'),approval.approval_proposal_raw_sha256);
  const proposal=JSON.parse(fs.readFileSync(path.join(root,delivery+'acceptance-proposal.json')));
  assert.equal(proposal.root_review_recorded,false);assert.equal(proposal.status,'unsigned_proposal_for_root_review');
  assert.deepEqual({...approval,status:proposal.status,root_review_recorded:false,reviewer:null,recorded_at:null,approval_proposal_raw_sha256:null},proposal);
  const native=JSON.parse(fs.readFileSync(path.join(root,r.native_probe.path)));
  assert.equal(raw(r.native_probe.path),'0ddf066f15735f19596e1a8c4a40a154900d40fe4fbeb7ac8df7bcc841e5d6e4');
  assert.equal(native.status,'scratch_native_checks_passed_not_production_acceptance');assert.equal(native.native.checks,870);assert.deepEqual(native.native.failures,[]);
  assert.equal(native.native.cases.length,95);assert.ok(native.native.cases.every(c=>c.passed&&c.checks>0));
  assert.deepEqual(native.native.cases.map(c=>c.id),r.runtime_case_proposal.cases.map(c=>c.id));assert.deepEqual(native.native.case_counts,r.runtime_case_proposal.case_counts);
  const nativeDir=path.dirname(r.native_probe.path);for(const [file,sha]of Object.entries(native.local_raw_sha256))assert.equal(raw(nativeDir+'/'+file),sha);
  assert.equal(raw(nativeDir+'/'+native.script_snapshot),native.script_raw_sha256);assert.equal(raw(nativeDir+'/'+native.log_file),native.log_raw_sha256);
  const lineage=JSON.parse(fs.readFileSync(path.join(root,nativeDir,'revision-lineage.json')));for(const [file,sha]of Object.entries(lineage.predecessor_raw_sha256))assert.equal(raw(file),sha);
  const failed=JSON.parse(fs.readFileSync(path.join(root,'build/professional-english/retail-module04-morphology-review/second10/native-probe-r02/runtime-attempt-01-diagnostic.json')));
  assert.equal(failed.status,'failed_native_attempt_preserved_no_acceptance');assert.equal(failed.native.checks,855);assert.equal(failed.native.failures.length,2);
  const validation=JSON.parse(fs.readFileSync(path.join(root,r.production_validation.path)));
  assert.equal(raw(r.production_validation.path),r.production_validation.raw_sha256);assert.equal(validation.ok,true);assert.equal(validation.registry_after_sha256,r.integration.before_registry_sha256);
  const transaction=r.integration.transaction_path,states=fs.readdirSync(path.join(root,transaction,'states')).filter(f=>/^\d{6}-[a-z-]+\.json$/.test(f)).sort();
  const committed=JSON.parse(fs.readFileSync(path.join(root,transaction,'states',states.at(-1))));assert.equal(committed.status,'committed');assert.equal(committed.prepared_sha256,raw(transaction+'/prepared.json'));
  for(const [i,patch]of r.patches.entries()){
    assert.equal(hash(r.author_candidates[i]),patch.original_candidate_json_sha256);assert.equal(approval.decisions[i].candidate_json_sha256,patch.original_candidate_json_sha256);assert.equal(approval.decisions[i].decision,'accept_at_declared_teaching_depth');
    const restored=structuredClone(patch.after.morphology);restored.review.status='pending';restored.review.independent_review='not_completed';for(const key of ['reviewer','reviewed_at','acceptance_record'])delete restored.review[key];
    assert.deepEqual(restored,r.author_candidates[i]);assert.equal(restored.review.status,'pending');
  }
});

test('Retail04 second ten alter morphology only and preserve context, source, Growth and domain gates', () => {
  const r=retail04SecondRecord,withoutMorphology=e=>Object.fromEntries(Object.entries(e).filter(([k])=>k!=='morphology'));
  for(const patch of r.patches){const actual=data.lexemes.find(e=>e.id===patch.id);assert.deepEqual(actual,patch.after);assert.equal(hash(patch.before),patch.before_sha256);assert.deepEqual(withoutMorphology(actual),withoutMorphology(patch.before));assert.equal(hash(withoutMorphology(actual)),patch.protected_fields_sha256);assert.equal(actual.editorial_notes,patch.before.editorial_notes);assert.deepEqual(morphologyErrors(actual.morphology,actual),[]);assert.equal(actual.morphology.review.status,'reviewed');assert.ok(actual.morphology.review.source_record_ids.every(id=>r.sources.some(s=>s.id===id)));}
  assert.equal(r.protected_related_entries.length,48);for(const row of r.protected_related_entries)assert.deepEqual(beforeCardReaderBarcodeAudio(data.lexemes.find(e=>e.id===row.entry.id)),row.entry);
  assert.equal(r.protected_modules.length,45);for(const row of r.protected_modules)assert.equal(hash(data.courses.find(c=>c.id===row.course_id).modules.find(m=>m.id===row.module_id)),row.json_sha256);
  assert.equal(r.protected_expressions.length,450);for(const row of r.protected_expressions)assert.equal(hash(data.expressions.find(e=>e.id===row.entry.id)),row.json_sha256);
  assert.equal(r.protected_existing_sources.length,168);for(const row of r.protected_existing_sources)assert.deepEqual(data.sources.find(s=>s.id===row.source.id),row.source);
  for(const expected of r.sources){assert.deepEqual(data.sources.find(s=>s.id===expected.id),expected);assert.equal(expected.status,'consulted');assert.equal(expected.assets_acquired,false);assert.equal(expected.asset_license,null);}
  for(const row of r.protected_growth_entries)assert.deepEqual(JSON.parse(fs.readFileSync(path.join(root,row.resource))).entries.find(e=>e.id===row.entry.id),row.entry);
  const raw=file=>crypto.createHash('sha256').update(fs.readFileSync(path.join(root,file))).digest('hex');for(const [file,sha]of Object.entries(r.protected_growth_raw_sha256))assert.equal(raw(file),sha);
  const supplement=r.protected_growth_dependency_supplement;assert.equal(raw(supplement.growth_index.resource),supplement.growth_index.raw_sha256);const words=JSON.parse(fs.readFileSync(path.join(root,'words.json')));for(const row of supplement.actual_growth_words)assert.deepEqual(words.find(w=>w.id===row.entry_id),row.word);
  assert.equal(r.selected_memberships.reduce((n,row)=>n+row.memberships.length,0),21);for(const row of r.selected_memberships)assert.deepEqual(data.courses.flatMap(c=>c.modules.filter(m=>m.lexeme_ids.includes(row.id)).map(m=>({course_id:c.id,module_id:m.id}))),row.memberships);
  assert.equal(r.patches.filter(p=>p.after.review.domain==='pending').length,7);assert.deepEqual(r.patches.filter(p=>p.after.review.domain==='not_required').map(p=>p.after.text),['cotton','wool','leather']);assert.ok(data.courses.every(c=>c.modules.every(m=>m.status==='draft')));
});

test('Retail04 second ten retain declared noun depth, exact new pairs and sense boundaries', () => {
  const r=retail04SecondRecord,graph=text=>r.patches.find(p=>p.after.text===text).after.morphology,pairs=text=>graph(text).parts.map(p=>[p.canonical_id,p.canonical]);
  assert.equal(r.patches.filter(p=>p.after.morphology.kind==='atomic').length,8);assert.deepEqual(r.new_canonical_pairs,[['morph.ceramic','ceramic'],['morph.part.tissue.wrapping-paper','tissue']]);assert.deepEqual(r.canonical_migrations,[]);
  for(const [text,id]of Object.entries({cotton:'morph.cotton',wool:'growth.wool',leather:'morph.leather',plastic:'growth.plastic',glass:'growth.part.glass.material',ceramic:'morph.ceramic',metal:'morph.metal',wood:'growth.wood'})){assert.deepEqual(pairs(text),[[id,text]]);assert.deepEqual(graph(text).nodes,[]);assert.deepEqual(graph(text).roots,['whole']);}
  assert.deepEqual(pairs('cardboard'),[['growth.card','card'],['growth.part.board.sheet','board']]);assert.deepEqual(graph('cardboard').nodes,[{id:'whole',left:'p1',right:'p2',surface:'cardboard',rule:'card-plus-sheet-board',break_offsets:[]}]);
  assert.deepEqual(pairs('tissue paper'),[['morph.part.tissue.wrapping-paper','tissue'],['growth.paper','paper']]);assert.deepEqual(graph('tissue paper').nodes,[{id:'whole',left:'p1',right:'p2',surface:'tissue paper',rule:'tissue-plus-paper-word-boundary',break_offsets:[7]}]);assert.deepEqual(r.patches.find(p=>p.after.text==='tissue paper').after.accepted_forms,['tissue paper']);
  assert.deepEqual(r.patches.filter(p=>p.before.morphology===null).map(p=>p.after.text),['ceramic']);assert.equal(r.patches.filter(p=>p.before.morphology?.review.status==='pending').length,9);
  for(const [text,history]of Object.entries({plastic:/Historical molding\/adjectival structure is real/,ceramic:/Greek clay-base\/adjectival structure remains acknowledged/})){const d=r.independent_decisions.decisions.find(d=>d.text===text);assert.match(d.independent_reason,history);assert.equal(d.depth,'whole-current-material-noun exposure only');assert.equal(d.composition_mastery_allowed_by_editorial_review,false);assert.equal(d.production_acceptance,false);}
  assert.equal(data.courses.find(c=>c.id==='retail').modules.find(m=>m.id==='module04').lexeme_ids.filter(id=>data.lexemes.find(e=>e.id===id).morphology?.review.status==='reviewed').length,30);
});


