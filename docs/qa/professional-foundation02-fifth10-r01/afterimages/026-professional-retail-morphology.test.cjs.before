  entry = beforeCounterCheckoutAudio(entry);
  const patch = counterImageRecord.patches.find(item => item.id === entry.id);
  if (!patch) return entry;
  assert.deepEqual(entry, patch.after, entry.id + ': exact later counter image and note delta');
  return structuredClone(patch.before);
}
function beforeRetailMedia(entry) {
  entry = beforeFoundationLanguage(entry);
  let historical = beforeFifth10(beforeRetail04First10(entry));
  for (const record of [...mediaRecords].reverse()) {
    const patch = record.patches.find(item => (item.sense_id || item.id) === entry.id);
    if (!patch) continue;
    assert.deepEqual(historical, patch.after, entry.id + ': exact later accepted media and note delta');
    historical = structuredClone(patch.before);
  }
  return historical;
}
const data = loadProfessionalContent(root);
const hash = value => crypto.createHash('sha256').update(JSON.stringify(value)).digest('hex');
const protect = entry => {const copy = structuredClone(entry); delete copy.morphology; delete copy.editorial_notes; return copy;};

test('Retail first ten morphology decisions have exact independent provenance and preserve other gates', () => {
  assert.equal(record.independent_approval.accepted, true);
  assert.equal(record.independent_approval.ledger_json_sha256, '90843f4dfcd11b7336f35134d83d0af5a65cf272007db31900825e43fdedeeee');
  assert.equal(record.patches.length, 10);
  assert.equal(record.sources.length, 29);
  for (const patch of record.patches) {
    const entry = beforeRetailMedia(data.lexemes.find(e => e.id === patch.id));
    assert.equal(hash(patch.before), patch.before_sha256);
    assert.equal(hash(protect(patch.before)), patch.protected_fields_sha256);
    assert.deepEqual(entry, patch.after);
    assert.deepEqual(protect(entry), protect(patch.before));
    assert.deepEqual(morphologyErrors(entry.morphology, entry), []);
    assert.equal(entry.morphology.review.status, 'reviewed');
    assert.match(entry.morphology.review.reviewer, /independent AI morphology review; not human or subject-matter approval/);
    assert.doesNotMatch(entry.editorial_notes, /Morphology remains unauthored|morphology graph remains pending/);
    for (const id of entry.morphology.review.source_record_ids) assert.ok(record.sources.some(s => s.id === id));
  }
  for (const source of record.sources) assert.deepEqual(data.sources.find(s => s.id === source.id), source);
  assert.ok(data.courses.every(c => c.modules.every(m => m.status === 'draft')));
});

test('Equipment morphology uses meaningful modern constituents and explicit authored spellings', () => {
  const graph = text => data.lexemes.find(e => record.patches.some(p => p.id === e.id) && e.text === text).morphology;
  const parts = text => graph(text).parts.map(p => p.canonical);
  assert.deepEqual(parts('aisle'), ['aisle']);
  assert.deepEqual(parts('counter'), ['counter']);
  assert.deepEqual(parts('checkout'), ['check', 'out']);
  assert.deepEqual(parts('cash register'), ['cash', 'register']);
  assert.deepEqual(parts('card reader'), ['card', 'read', '-er']);
  assert.deepEqual(parts('barcode'), ['bar', 'code']);
  assert.deepEqual(parts('barcode scanner'), ['bar', 'code', 'scan', '-er']);
  assert.deepEqual(parts('receipt printer'), ['receipt', 'print', '-er']);
  assert.deepEqual(parts('cash drawer'), ['cash', 'draw', '-er']);
  assert.deepEqual(parts('conveyor belt'), ['convey', '-or', 'belt']);
  assert.equal(graph('barcode scanner').nodes.find(n => n.id === 'scanner').surface, 'scanner');
  assert.match(graph('barcode scanner').nodes.find(n => n.id === 'scanner').rule, /double-final-n/);
  for (const text of ['cash register','card reader','barcode scanner','receipt printer','cash drawer','conveyor belt']) {
    const whole = graph(text).nodes.at(-1);
    assert.equal(whole.surface, text);
    assert.deepEqual(whole.break_offsets, [text.indexOf(' ') + 1]);
  }
  assert.match(graph('receipt printer').review.notes, /current receipt stem/);
  assert.match(graph('cash register').review.notes, /does not invent regist plus agent-er/);
  assert.match(graph('conveyor belt').review.notes, /modern derivational depth/);
});

test('Canonical reuse and evidence limits stay explicit without changing existing families', () => {
  const decisions = record.independent_approval.canonical_decisions;
  assert.deepEqual(decisions.filter(p => !p.existing_professional_occurrences).map(p => p.name), ['convey']);
  const scanner = data.lexemes.find(e => e.id === 'barcode-scanner.product-reader.n').morphology;
  const reader = data.lexemes.find(e => e.id === 'card-reader.payment-device.n').morphology;
  assert.deepEqual(scanner.parts.at(-1), {...reader.parts.at(-1), id:'p4'});
  const limited = record.source_consultation_ledger.find(s => s.id === 'retail03-morph-cambridge-doubling-access-limited');
  assert.equal(limited.access, 'search_excerpt_only_direct_page_403');
  assert.match(record.sources.find(s => s.id === limited.id).scope, /supplementary only/);
  assert.ok(!scanner.review.source_record_ids.includes(limited.id));
  assert.equal(record.independent_approval.fresh_crosschecks.length, 8);
});

test('Nine next decisions preserve exact independent provenance, other content gates and held display case', () => {
  const approval = nextRecord.independent_approval;
  assert.equal(approval.accepted, true);
  assert.equal(approval.ledger_json_sha256, '80d88a86bb695177151c2497341a8519e223db546f707c255e8268041f10999d');
  assert.equal(approval.canonical_correction_json_sha256, 'c61c1a4bd98c3cdb4fa0d05dab49e912629dc791abd43652aa68de19d596e947');
  assert.equal(hash(approval.canonical_correction), approval.canonical_correction_json_sha256);
  assert.equal(nextRecord.patches.length, 9);
  assert.equal(nextRecord.sources.length, 24);
  assert.equal(nextRecord.appended_source_ids.length, 23);
  assert.equal(approval.fresh_crosschecks.length, 10);
  for (const patch of nextRecord.patches) {
    const entry = beforeRetailMedia(data.lexemes.find(e => e.id === patch.id));
    assert.equal(hash(patch.before), patch.before_sha256);
    assert.equal(hash(protect(patch.before)), patch.protected_fields_sha256);
    assert.deepEqual(entry, patch.after);
    assert.deepEqual(protect(entry), protect(patch.before));
    assert.deepEqual(morphologyErrors(entry.morphology, entry), []);
    assert.equal(entry.morphology.review.status, 'reviewed');
    assert.match(entry.morphology.review.reviewer, /independent AI morphology review; not human or subject-matter approval/);
    assert.doesNotMatch(entry.editorial_notes, /Morphology remains unauthored|morphology graph remains pending/);
    for (const id of entry.morphology.review.source_record_ids) assert.ok(nextRecord.sources.some(s => s.id === id));
  }
  assert.equal(nextRecord.holds.length, 1);
  const hold = nextRecord.holds[0];
  assert.equal(hold.id, 'display-case.glass-cabinet.n');
  assert.equal(hash(hold.before), hold.before_sha256);
  const later = caseRecord.patches.find(p => p.id === hold.id);
  assert.deepEqual(data.lexemes.find(e => e.id === hold.id), later.after);
  assert.deepEqual(later.before, hold.before);
  assert.equal(hold.before.morphology, null);
  for (const source of nextRecord.sources) assert.deepEqual(data.sources.find(s => s.id === source.id), source);
  assert.ok(data.courses.every(c => c.modules.every(m => m.status === 'draft')));
});

test('Next compound graphs author doubling and final-e omission while keeping current-stem atomic choices', () => {
  const graph = text => nextRecord.patches.find(p => p.after.text === text).after.morphology;
  for (const [text,stem,surface] of [
    ['shopping basket','shop','shopping'], ['shopping cart','shop','shopping'],
    ['fitting room','fit','fitting'], ['clothing rack','clothe','clothing'], ['loading bay','load','loading']
  ]) {
    const g = graph(text);
    assert.equal(g.parts[0].canonical, stem);
    assert.equal(g.parts[1].canonical, '-ing');
    assert.equal(g.nodes[0].surface, surface);
    assert.equal(g.nodes.at(-1).surface, text);
    assert.deepEqual(g.nodes.at(-1).break_offsets, [text.indexOf(' ') + 1]);
  }
  for (const text of ['shopping basket', 'shopping cart']) assert.match(graph(text).nodes[0].rule, /double-p/);
  assert.match(graph('fitting room').nodes[0].rule, /double-t/);
  assert.match(graph('clothing rack').nodes[0].rule, /(?:drop|omit)-final-e/);
  assert.deepEqual(graph('hanger').parts.map(p => p.canonical), ['hang', '-er']);
  assert.deepEqual(graph('stockroom').parts.map(p => p.canonical), ['stock', 'room']);
  for (const text of ['shelf', 'mannequin']) {
    assert.deepEqual(graph(text).parts.map(p => p.canonical), [text]);
    assert.equal(graph(text).nodes.length, 0);
  }
});

test('Accepted nominal ing families reuse exact Growth identities and preserve unrelated legacy candidates', () => {
  const correction = nextRecord.independent_approval.canonical_correction;
  assert.equal(correction.patches.length, 5);
  for (const family of correction.reused_families) {
    const bytes = fs.readFileSync(path.join(root, family.source_resource));
    assert.equal(crypto.createHash('sha256').update(bytes).digest('hex'), family.source_resource_raw_sha256);
    const entry = JSON.parse(bytes).entries.find(e => e.text === family.target);
    assert.deepEqual(entry, family.source_entry);
    assert.equal(entry.review.status, 'reviewed');
  }
  for (const patch of correction.patches) {
    assert.equal(hash(patch.before), patch.original_candidate_json_sha256);
    assert.equal(hash(patch.after), patch.corrected_candidate_json_sha256);
    const expected = structuredClone(patch.before);
    expected.parts[1].canonical_id = patch.after_canonical_id;
    assert.deepEqual(patch.after, expected);
    const graph = data.lexemes.find(e => e.id === patch.id).morphology;
    assert.deepEqual({...graph, review:patch.after.review}, patch.after);
    assert.equal(graph.parts[1].canonical_id, patch.role === 'activity' ? 'english.affix.ing.activity' : 'english.affix.ing.result-noun');
  }
  for (const occurrence of correction.finding.inventory.filter(o => !nextRecord.patches.some(p => p.id === o.lexeme_id))) {
    const entry = beforeRetailMedia(data.lexemes.find(e => e.id === occurrence.lexeme_id));
    const later = thirdRecord.patches.find(p => p.id === entry.id);
    if (later) {
      assert.equal(hash(later.before), occurrence.entry_json_sha256);
      assert.deepEqual(entry, later.after);
    } else {
      assert.equal(hash(entry), occurrence.entry_json_sha256);
      assert.equal(entry.morphology.review.status, 'pending');
    }
  }
  const source = nextRecord.sources.find(s => s.id === 'retail03-morph-next10-dcom-ing');
  assert.match(source.scope, /activity and result-noun candidates reuse/);
  assert.equal(nextRecord.independent_approval.source_registration_clarifications.length, 1);
  assert.match(nextRecord.source_consultation_ledger.find(s => s.id === source.id).finding, /retain the existing exact Professional suffix pair/);
});

test('Case-family correction changes five pending canonical identities without promoting their graphs', () => {
  assert.equal(caseRecord.independent_approval.accepted, true);
  assert.equal(hash(caseRecord.proposal), 'a99e2875f8fc8b41aa1c802500393555123801349e4e085a366aef53a9c6a0d2');
  assert.equal(caseRecord.patches.length, 6);
  for (const migration of caseRecord.proposal.migrations) {
    const patch = caseRecord.patches.find(p => p.id === migration.id);
    const expected = structuredClone(patch.before);
    expected.morphology.parts[migration.operation.path[2]].canonical_id = 'growth.part.case.container';
    assert.equal(hash(patch.before), patch.before_sha256);
    assert.deepEqual(patch.after, expected);
    assert.deepEqual(data.lexemes.find(e => e.id === patch.id), expected);
    assert.equal(expected.morphology.review.status, 'pending');
    assert.deepEqual(expected.morphology.review, patch.before.morphology.review);
  }
  for (const classification of caseRecord.proposal.classifications.filter(c => c.family === 'event_matter')) {
    const entry = data.lexemes.find(e => e.id === classification.id);
    assert.deepEqual(entry, classification.before_entry);
    assert.equal(entry.morphology.parts[classification.part_index].canonical_id, 'morph.case');
  }
  for (const [file, expected] of Object.entries(caseRecord.proposal.preservation.growth_raw_sha256)) {
    assert.equal(crypto.createHash('sha256').update(fs.readFileSync(path.join(root, file))).digest('hex'), expected);
  }
});

