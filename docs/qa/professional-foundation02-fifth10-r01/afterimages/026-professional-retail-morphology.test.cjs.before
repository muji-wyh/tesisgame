test('Fourth-ten review keeps historical customer derivation and Growth escalator approval separate', () => {
  const customer = data.lexemes.find(entry => entry.id === 'customer.buyer.n');
  const wholeCustomer = data.lexemes.find(entry => entry.id === 'customer-service-desk.help-counter.n');
  assert.equal(customer.morphology.review.status, 'pending');
  assert.deepEqual(customer.morphology.parts.map(part => part.canonical), ['custom', '-er']);
  assert.equal(wholeCustomer.morphology.parts[0].canonical_id, 'morph.customer');
  assert.equal(wholeCustomer.morphology.parts[0].canonical, 'customer');
  const escalator = fourthRecord.patches.find(patch => patch.id === 'escalator.moving-stairway.n');
  assert.equal(escalator.before.morphology.review.status, 'pending');
  assert.equal(escalator.before.morphology.review.provenance.corpus, 'Growth');
  assert.equal(escalator.after.morphology.review.status, 'reviewed');
  assert.equal(escalator.after.morphology.review.acceptance_record, 'data/professional/provenance/retail-module03-morphology-fourth10-2026-10-16.json');
  assert.deepEqual(escalator.before.morphology.roots, ['whole']);
  assert.deepEqual(escalator.after.morphology.roots, ['p1']);
  assert.deepEqual(escalator.after.morphology.parts, escalator.before.morphology.parts.map(part => ({...part, id: 'p1'})));
  const growth = JSON.parse(fs.readFileSync(path.join(root, 'data/vocabulary/morphology/age-08.json'))).entries.find(entry => entry.id === 'escalator');
  assert.equal(growth.review.status, 'reviewed');
  assert.notEqual(growth.analysis.lexeme_id, escalator.after.morphology.lexeme_id);
  assert.deepEqual(growth.analysis.parts, escalator.before.morphology.parts);
  const elevator = data.lexemes.find(entry => entry.id === 'elevator.vertical-transport.n');
  assert.equal(elevator.review.domain, 'pending');
  assert.equal(elevator.media.image.status, 'pending');
  assert.equal(elevator.media.image.review.status, 'pending');
  assert.equal(elevator.media.audio.status, 'pending');
});

