test('Fourth ten author current constituents, spelling changes and exact grammatical suffix roles', () => {
  const graph = text => fourthRecord.patches.find(patch => patch.after.text === text).after.morphology;
  const expected = {
    'alarm gate': ['alarm', 'gate'], escalator: ['escalator'], elevator: ['elevate', '-or'],
    entrance: ['enter', '-ance'], exit: ['exit'], 'automatic door': ['automatic', 'door'],
    'customer service desk': ['customer', 'service', 'desk'], 'pickup counter': ['pick', 'up', 'counter'],
    'returns counter': ['return', '-s', 'counter'], 'queue barrier': ['queue', 'barrier']
  };
  for (const [text, parts] of Object.entries(expected)) {
    const value = graph(text);
    assert.deepEqual(value.parts.map(part => part.canonical), parts, text);
    if (parts.length === 1) assert.deepEqual(value.nodes, []);
    else assert.equal(value.nodes.at(-1).surface, text);
  }
  assert.equal(graph('alarm gate').parts[1].canonical_id, 'english.base.gate.passage');
  assert.equal(graph('elevator').parts[0].canonical_id, 'english.base.elevate.raise');
  assert.match(graph('elevator').nodes[0].rule, /instrument-or-drop-final-e/);
  assert.equal(graph('elevator').parts[1].canonical_id, 'affix.or.suffix');
  assert.equal(graph('entrance').parts[0].canonical_id, 'growth.enter');
  assert.equal(graph('entrance').parts[1].canonical_id, 'affix.ance.suffix');
  assert.match(graph('entrance').nodes[0].rule, /enter-to-entr/);
  assert.equal(graph('pickup counter').nodes[0].surface, 'pickup');
  assert.deepEqual(graph('pickup counter').nodes[0].break_offsets, []);
  assert.deepEqual(graph('pickup counter').nodes[1].break_offsets, [7]);
  assert.equal(graph('returns counter').parts[1].canonical_id, 'english.affix.s.plural');
  assert.equal(graph('returns counter').nodes[0].surface, 'returns');
  assert.deepEqual(graph('customer service desk').nodes.map(node => [node.left, node.right, node.surface, node.break_offsets]), [
    ['p1', 'p2', 'customer service', [9]], ['customer-service', 'p3', 'customer service desk', [9, 17]]
  ]);
  assert.deepEqual(fourthRecord.independent_approval.canonical_decisions.filter(item => item.new_pair).map(item => item.name), ['gate', 'elevate']);
});

