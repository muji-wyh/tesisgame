test('Third ten reviews preserve lexical and media gates with exact source and graph provenance', () => {
  const approval = thirdRecord.independent_approval;
  assert.equal(approval.accepted, true);
  assert.equal(approval.ledger_json_sha256, 'd2106b1b6dd7dee62729cab440291112a26c97faaae9dff7bf4068c495199dbb');
  assert.equal(approval.canonical_audit_json_sha256, '250e472dc83721030048edb86f823c46292dbb9a097e2c1c51e5de344372c163');
  assert.equal(approval.held_candidates_json_sha256, hash(thirdRecord.original_held_candidate));
  assert.equal(thirdRecord.patches.length, 10);
  assert.equal(thirdRecord.sources.length, 35);
  assert.equal(thirdRecord.appended_source_ids.length, 34);
  assert.equal(approval.independent_crosschecks.findings.length, 11);
  for (const patch of thirdRecord.patches) {
    const entry = beforeRetailMedia(data.lexemes.find(e => e.id === patch.id));
    assert.equal(hash(patch.before), patch.before_sha256);
    assert.equal(hash(protect(patch.before)), patch.protected_fields_sha256);
    assert.deepEqual(entry, patch.after);
    assert.deepEqual(protect(entry), protect(patch.before));
    assert.deepEqual(morphologyErrors(entry.morphology, entry), []);
    assert.equal(entry.morphology.review.status, 'reviewed');
    assert.match(entry.morphology.review.reviewer, /independent AI morphology review; not human or subject-matter approval/);
    assert.doesNotMatch(entry.editorial_notes, /Morphology remains unauthored|morphology graph remains pending/);
    for (const id of entry.morphology.review.source_record_ids) assert.ok(thirdRecord.sources.some(s => s.id === id));
  }
  for (const source of thirdRecord.sources) assert.deepEqual(data.sources.find(s => s.id === source.id), source);
  assert.ok(!thirdRecord.appended_source_ids.includes('retail03-morph-dcom-er'));
  for (const snapshot of thirdRecord.protected_modules) {
    const module = data.courses.find(c => c.id === snapshot.course_id).modules.find(m => m.id === snapshot.module_id);
    assert.equal(hash(module), snapshot.json_sha256);
  }
  for (const snapshot of thirdRecord.protected_expressions) assert.equal(hash(data.expressions.find(e => e.id === snapshot.entry.id)), snapshot.json_sha256);
  assert.ok(data.courses.every(c => c.modules.every(m => m.status === 'draft')));
});

test('Third ten use explicit current bases, suffix roles and authored final-e omission', () => {
  const graph = text => data.lexemes.find(e => e.text === text && thirdRecord.patches.some(p => p.id === e.id)).morphology;
  const expected = {
    pallet:['pallet'], 'pallet jack':['pallet','jack'], 'hand truck':['hand','truck'],
    'price tag':['price','tag'], 'label printer':['label','print','-er'],
    'weighing scale':['weigh','-ing','scale'], freezer:['freeze','-er'],
    refrigerator:['refrigerate','-or'], 'security camera':['secure','-ity','camera'], 'security tag':['secure','-ity','tag']
  };
  for (const [text, parts] of Object.entries(expected)) {
    const g = graph(text);
    assert.deepEqual(g.parts.map(p => p.canonical), parts);
    if (text.includes(' ')) assert.deepEqual(g.nodes.at(-1).break_offsets, [text.indexOf(' ') + 1]);
  }
  assert.equal(graph('pallet jack').parts[1].canonical_id, 'english.base.jack.lifting-device');
  for (const text of ['freezer','refrigerator','security camera','security tag']) assert.match(graph(text).nodes[0].rule, /drop-final-e/);
  assert.equal(graph('refrigerator').parts[0].canonical_id, 'growth.refrigerate');
  assert.equal(graph('security camera').parts[1].canonical_id, 'english.affix.ity.quality');
  assert.deepEqual(graph('security camera').parts.slice(0, 2), graph('security tag').parts.slice(0, 2));
  assert.match(graph('security camera').review.notes, /borrowed from Latin/);
});

test('Weighing-scale acceptance resolves only the held target and preserves four pending legacy meanings', () => {
  const held = thirdRecord.original_held_candidate;
