});


test('Foundation02 second-ten language leaves every morphology graph pending and preserves historical donors', () => {
  const r=foundation02SecondLanguageRecord;
  for(const p of r.patches){const entry=data.lexemes.find(x=>x.id===p.id);assert.deepEqual(entry,p.after);assert.deepEqual(entry.morphology,p.before.morphology);assert.equal(entry.morphology.review.status,'pending');assert.deepEqual(beforeFoundationLanguage(entry),p.before);const bad=structuredClone(entry);bad.morphology.parts[0].canonical_id+='drift';assert.throws(()=>beforeFoundationLanguage(bad));}
  for(const [record,id]of [[fourthRecord,'return.send-back.v'],[retail04FirstRecord,'arrange.organize.v']]){const historical=record.protected_related_entries.find(x=>x.entry.id===id);assert(historical);const live=data.lexemes.find(x=>x.id===id);assert.deepEqual(beforeFoundationLanguage(live),historical.entry);assert.deepEqual(live.morphology,historical.entry.morphology);}
});


test('Foundation02 third-ten language leaves exact morphology, media and historical Foundation donors unchanged', () => {
  for(const p of foundation02ThirdLanguageRecord.patches){const entry=data.lexemes.find(row=>row.id===p.id);assert.deepEqual(entry,p.after);assert.deepEqual(entry.morphology,p.before.morphology);assert.deepEqual(entry.media,p.before.media);assert.equal(entry.review.domain,p.before.review.domain);assert.equal(entry.morphology.review.status,'pending');assert.deepEqual(beforeFoundationLanguage(entry),p.before);const bad=structuredClone(entry);bad.morphology.parts[0].canonical_id+='drift';assert.throws(()=>beforeFoundationLanguage(bad));
    for(const history of [foundationLanguageRecord,foundationSecondLanguageRecord,foundationThirdLanguageRecord,foundationFourthLanguageRecord,foundationFifthLanguageRecord]){const snapshots=history.protected_context.lexemes.filter(row=>row.entry.id===p.id);assert.equal(snapshots.length,1);assert.deepEqual(beforeFoundationLanguage(entry),snapshots[0].entry);}
  }
});


test('Foundation02 fourth-ten language leaves exact morphology, media and historical Foundation donors unchanged', () => {
  assert.deepEqual(foundation02FourthLanguageRecord.patches.map(p=>p.id),['submit.send-for-consideration.v','approve.authorize.v','reject.decline-acceptance.v','sign.write-name.v','delay.late-occurrence.n','error.mistake.n','fault.equipment-defect.n','damage.physical-harm.n','shortage.insufficient-supply.n','missing.not-present.adj']);
  for(const p of foundation02FourthLanguageRecord.patches){const entry=data.lexemes.find(row=>row.id===p.id);assert.deepEqual(entry,p.after);assert.deepEqual(entry.morphology,p.before.morphology);assert.deepEqual(entry.media,p.before.media);assert.equal(entry.review.domain,p.before.review.domain);assert.equal(entry.morphology.review.status,'pending');assert.deepEqual(beforeFoundationLanguage(entry),p.before);const bad=structuredClone(entry);bad.morphology.parts[0].canonical_id+='drift';assert.throws(()=>beforeFoundationLanguage(bad));
    const histories=[foundationLanguageRecord,foundationSecondLanguageRecord,foundationThirdLanguageRecord,foundationFourthLanguageRecord,foundationFifthLanguageRecord];
    const expectedCounts=p.id==='sign.write-name.v'?[1,1,1,1,2]:[1,1,1,1,1];
    const expectedRow={resource:'res://data/professional/lexemes/foundation-module02.json',json_sha256:p.before_sha256,entry:p.before};
    assert.equal(data.lexemeOrigins[p.id],expectedRow.resource);
    for(const [historyIndex,history] of histories.entries()){
      const snapshots=history.protected_context.lexemes.filter(row=>row.entry.id===p.id);
      assert.equal(snapshots.length,expectedCounts[historyIndex],p.id+': exact historical snapshot multiplicity '+historyIndex);
      for(const snapshot of snapshots){
        assert.deepEqual(snapshot,expectedRow,p.id+': exact whole historical donor row '+historyIndex);
        assert.deepEqual(snapshot.entry,beforeFoundationLanguage(entry),p.id+': exact historical reversal '+historyIndex);
      }
    }
  }
});
