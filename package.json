{
  "name": "tesisgame",
  "version": "1.0.0",
  "description": "A Godot-powered English matching game delivered on the Web.",
  "private": true,
  "homepage": "https://github.com/muji-wyh/tesisgame#readme",
  "bugs": {
    "url": "https://github.com/muji-wyh/tesisgame/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muji-wyh/tesisgame.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node tools/prepare-godot.cjs",
    "import": "node tools/prepare-godot.cjs && node tools/run-godot.cjs --headless --path . --import",
    "pretest": "npm run import",
    "test": "node tools/run-tests.cjs all",
    "test:voice-pop": "node tools/run-tests.cjs voice-pop",
    "test:layout-release": "node tools/run-tests.cjs layout-release",
    "build:web": "node tools/build-web.cjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\deploy-web.ps1",
    "prestart": "npm run build:web",
    "start": "npm run serve:web",
    "serve:web": "http-server build/web -a 127.0.0.1 -p 41773 --brotli -c-1",
    "pretest:browser": "npm run build:web",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "test:flow": "node tools/run-tests.cjs flow",
    "test:legacy-saves": "node tools/run-tests.cjs legacy-saves",
    "test:ages": "node tools/run-tests.cjs ages",
    "test:cards": "node tools/run-tests.cjs cards",
    "test:hint-link": "node tools/run-tests.cjs hint-link",
    "test:match-groups": "node tools/run-tests.cjs match-groups",
    "test:playful-ui": "node tools/run-tests.cjs playful-ui",
    "test:themes": "node tools/run-tests.cjs themes",
    "test:pip-audio": "node tools/run-tests.cjs pip-audio",
    "test:chest-charge": "node tools/run-tests.cjs chest-charge"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1"
  }
}
