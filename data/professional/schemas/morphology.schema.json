{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morphology.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "lexeme_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "atomic",
        "morphological",
        "compound",
        "phrase"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "canonical_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "type": {
            "enum": [
              "atomic",
              "root",
              "stem",
              "prefix",
              "suffix",
              "compound",
              "combining_form",
              "word",
              "abbreviation"
            ]
          },
          "canonical": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "break_offsets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "id",
          "canonical_id",
          "type",
          "canonical",
          "surface"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "left": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "right": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "break_offsets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "surface",
          "rule"
        ],
        "additionalProperties": false
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "id",
    "lexeme_id",
    "text",
    "kind",
    "review",
    "parts",
    "nodes",
    "roots"
  ],
  "additionalProperties": false
}
