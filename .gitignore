.idea/
node_modules
playwright-report
.playwright-mcp/
test-results
/%ALLUSERSPROFILE%/
*.tmp.wav
*.generating.wav
.godot/
build/*
!build/.gdignore
# Licensed Unity Store textures are shipped only inside the compiled game.
assets/imported-unity/
# Toon FX confetti is a licensed private input embedded in the game pack.
assets/images/jelly-match/confetti.png
assets/images/jelly-match/confetti.png.import
# Retired licensed Talk Quest sources remain private and are excluded from the game.
assets/talk_quest/monsters/*.glb
assets/talk_quest/monsters/*.glb.import
assets/talk_quest/monsters/*.png
assets/talk_quest/monsters/*.png.import
# Licensed chest render frames are private inputs embedded in the game pack.
assets/chests/downloaded/*/*.png
assets/chests/downloaded/*/*.png.import
# Licensed chest models and their source maps remain private build inputs.
assets/chests/models/
# Retired treasure-stage particles remain private archived inputs.
assets/talk_quest/treasure/halo.png
assets/talk_quest/treasure/halo.png.import
assets/talk_quest/treasure/ray.png
assets/talk_quest/treasure/ray.png.import
assets/talk_quest/treasure/sparkle.png
assets/talk_quest/treasure/sparkle.png.import
# User-provided audio ships in the game pack, not as public source assets.
assets/imported-audio/
*.unitypackage
__pycache__/

.env
