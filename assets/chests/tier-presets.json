{
  "version": 1,
  "source_notes": {
    "status": "integrated-native-four-view-reviewed",
    "native_base_mesh_families": 9,
    "modular_tier_count": 30,
    "source_manifest": "assets/chests/catalog-cc0/sources.json",
    "authorship": "Thirty proposed game-authored modular assemblies using nine acquired 3D base exteriors and six original CC0 ornament geometries. These are NOT thirty native source chest meshes.",
    "material_styling": "declared-in-game-adaptation-not-source-authored",
    "raw_asset_status": "CC0 inputs are byte-for-byte original GLBs, required palette textures and licenses. Existing five private GLBs are referenced only. No new texture remap, material override, opening animation, import or rendering has been applied.",
    "visual_validation": "All thirty assemblies have actual front/side/back/opened native captures, measured volumetric geometry and sampled lid-sweep clearance. Those captures were inspected across all thirty tiers. Browser/phone integration and physical-device performance are separate checks.",
    "opening": "open_animation names an actual existing clip, case sensitively. Kenney open is 0.3 seconds; existing private Open takes are game-authored 1-second curves. The KayKit family deliberately omits open_animation because its original GLB has only a separate static chest_lid; a future game-authored hinge is required.",
    "decoration_transform_contract": {
      "attachment_target": "body",
      "coordinate_space": "Base-local after the caller normalizes and orients the actual source chest: +Y up, +Z front, +X right. Use the actual body bounds below the lid seam, excluding lid motion, handles and other protruding ornaments.",
      "scale": "Positive scalar: desired largest ornament dimension as a fraction of the normalized chest width. Center the complete source ornament on its own 3D bounds, then uniformly scale it by chest_width * scale / ornament_largest_dimension. This is NOT an unnormalized multiplier on the original GLB units.",
      "rotation_degrees": "XYZ Euler angles in degrees, applied to the centered, uniformly scaled source ornament in the base-local frame. A front attachment faces +Z; side attachments turn around Y.",
      "placement": "At most one model per semantic anchor. Place the source mesh just outside the actual body surface without flattening it. Do not infer a safe surface or clearance from a bounding box alone. Keep attachments below the seam and with the body, not the lid.",
      "slots": {
        "front": "Center of the front body panel, below the actual lid seam.",
        "left": "Center of the left side body panel, below the seam.",
        "right": "Center of the right side body panel, below the seam.",
        "front-left": "Left third of the front body panel, clear of its clasp, hinge and handles.",
        "front-right": "Right third of the front body panel, mirrored from front-left."
      }
    },
    "material_style_contract": {
      "lookup": "material_style is an ID in material_styles below; the role values are proposed styling hints, not imported material names or already applied shader parameters.",
      "color_space": "base_color is an sRGB #RRGGBB color. metallic and roughness are unit-interval PBR hints.",
      "role_assignment": "Apply shell/trim/ornament_metal/gemstone hints only after identifying the corresponding original source regions. Keep source UVs, wood detail, inset structure and palette shading.",
      "atlas_warning": "Kenney and KayKit use a single source atlas material with metallicFactor 0. A whole-model metallic or color override would incorrectly affect wood as well as trim. Role-specific atlas masks/remaps or verified material-region assignments are future integration work, not supplied source functionality.",
      "ornaments": "Padlocks, framed shields and coins are real 3D source models. Shields are reused as escutcheons and coins as medallions; those placements and finishes are game adaptations. No procedural primitive, invented crown, sprite badge or additional native chest is implied."
    },
