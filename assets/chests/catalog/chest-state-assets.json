  "asset_policy": "Original acquired assets remain byte-preserved. A supported linked-instance coin stack is separately recorded as a source-derived composition; chest GLBs are unchanged.",
  "state_contract": {
    "open": "Opened empty chest; hide built-in Treasure and shared loot; no magic effects",
    "treasure": "Opened chest with genuine KayKit loot fitted to that chest cavity; prefer existing embedded Treasure when present",
    "magic": "Opened empty chest with tinted Kenney particle sprites emitted from the cavity; hide all coin geometry"
  },
