  "runtime_review": {
    "status": "All thirty modular assemblies integrated; front, side, back and opened actual native renders inspected.",
    "captures": "build/qa/chest-thirty-tiers/",
    "capture_index": "build/qa/chest-thirty-tiers/capture-index.json",
    "geometry_suite": "tests/godot/chest_tier_models_tests.gd",
    "scope": "Nine native base families with genuine sourced three-dimensional fittings, not thirty native meshes. Original file/acquisition facts below remain unchanged.",
    "browser": "Browser integration verification is separate; native rendering is not a physical-device performance claim."
  },
  "source_notes": {
    "scope": "Only raw CC0 GLBs, required original palette PNGs and original CC0 license files are copied here. No private Unity model, archive, source texture, shader, controller or import sidecar is copied. Existing private GLBs are metadata-only references.",
    "geometry_verification": "GLB JSON/binary inspected directly: actual POSITION spatial rank 3 for every primitive; unsigned index ranges and triangle topology checked. Vertex count sums per-primitive accessors, not unique geometric points. No engine, GPU render, importer or runtime integration was used.",
    "hash_verification": "source_sha256 is calculated on the original acquired file before copying; output_sha256 is recalculated on byte-identical output. No geometry, material, image, UV, clip or license normalization/conversion is applied.",
    "byte_preservation": "The scoped .gitattributes disables text conversion for raw GLB/PNG/LICENSE.txt inputs so original/output hashes remain stable across checkout line-ending settings. Original license bytes are not normalized.",
    "excluded_duplicates": [
      "Pirate Kit chest shares normalized body/lid geometry with Platformer Kit; it is not copied or counted as another base.",
      "KayKit chest_gold adds interior gold to the same chest exterior; it is not copied or counted as another native base.",
      "Bronze/silver/gold coin files share one geometry; only coin-gold is copied as a source medallion. Color changes are proposed material styling, not new meshes.",
      "Snow/non-snow crystal palettes share geometry; only the single original crystal is copied. The rock/crystal cluster is not needed by these recipes."
    ],
    "materials": "Kenney inputs and the KayKit base use source palette/gradient atlases with metallicFactor 0. Source-painted silver/gold is not already a metallic PBR finish. Semantic wood/trim/ornament/gem styling in tier-presets.json is a proposed in-game adaptation, not a raw source-material claim.",
    "opening": "Three distinct Kenney bases supply open/close/open-close clips and separate rigid lids. KayKit supplies a separate rigid chest_lid but no animation clips; later game-authored hinge motion is required. Existing five private GLBs contain their existing game-authored Open(1s) clips. Static ornaments have no clips.",
    "child_friendly_selection": "Kenney/KayKit chest and attachment source previews were inspected for this review; no skull/teeth/horror assets are selected. The retained private Harvest model is the already cleaned version documented in docs/assets/chest-refresh.md, not the original skull-decorated source prefab. Full thirty-preset art review is still pending.",
    "portable_tests": "Node tests use only committed CC0 inputs and tracked private-model metadata; installed private GLB hash comparisons are conditional. No machine-specific original source path is needed on another checkout.",
    "licensing": "CC0 inputs and original notices may be stored in Git. Referenced Unity assets remain private build inputs under their separate Standard EULA; this catalog does not relicence them as CC0."
  },
