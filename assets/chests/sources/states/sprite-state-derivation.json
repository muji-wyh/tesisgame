      [
        0,
        164
      ],
      [
        10,
        168
      ],
      [
        590,
        233
      ],
      [
        805,
        128
      ]
    ],
    "crystal_lid_lift_canvas_pixels": 220,
    "shared_canvas": "1024x1024 transparent RGBA. Each family's four states share one fixed placement and anchor; no per-state fitting."
