    "engine": "Blender Cycles",
    "samples": 64,
    "resolution": [
      768,
      768
    ],
    "reproducibleTool": "tools/prepare-quest-dimensional-map.py",
    "finishingTool": "tools/finish-quest-dimensional-map.py"
  },
